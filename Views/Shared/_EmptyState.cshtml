@model PharmacySystem.Models.Common.EmptyStateViewModel
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

<div class="ph-empty-state text-center p-5 my-4 border rounded-3 bg-white shadow-sm">
    <div class="ph-empty-icon mb-3 text-muted">
        <svg class="ph-icon" viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
            <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
        </svg>
    </div>
    <h5 class="fw-bold text-dark mb-2">@Model.Title</h5>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="text-muted small mb-4 mx-auto" style="max-width: 480px;">@Model.Description</p>
    }
    <div class="d-flex justify-content-center gap-2">
        @if (!string.IsNullOrWhiteSpace(Model.ActionText) && !string.IsNullOrWhiteSpace(Model.ActionUrl))
        {
            <a href="@Model.ActionUrl" class="btn btn-primary px-4 shadow-sm">
                @Model.ActionText
            </a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SecondaryActionText) && !string.IsNullOrWhiteSpace(Model.SecondaryActionUrl))
        {
            <a href="@Model.SecondaryActionUrl" class="btn btn-outline-secondary px-3">
                @Model.SecondaryActionText
            </a>
        }
    </div>
</div>
