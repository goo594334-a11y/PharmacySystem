@using Microsoft.Extensions.Localization
@using PharmacySystem.Authorization
@using PharmacySystem.Resources
@using PharmacySystem.Services.Auth
@inject IStringLocalizer<SharedResource> Loc
@inject ICurrentUserService CurrentUser

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string? action = null)
    {
        if (action == null)
            return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);

        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
               string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }
}

<aside class="ph-sidebar d-flex flex-column flex-shrink-0" id="phSidebar">
    @* Brand Header *@
    <div class="ph-sidebar-brand p-3 d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25">
        <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 text-white text-decoration-none">
            <div class="ph-brand-icon bg-teal text-white rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm">
                <svg class="ph-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path>
                    <path d="m8.5 8.5 7 7"></path>
                </svg>
            </div>
            <div class="ph-brand-text">
                <span class="fs-6 fw-bold text-teal-light d-block lh-1">@Loc["AppTitle"]</span>
                <span class="text-secondary small" style="font-size: 0.72rem;">Rx Pharmacy Suite</span>
            </div>
        </a>
        <button class="btn btn-sm btn-link text-secondary d-lg-none" id="phSidebarClose" type="button" aria-label="@Loc["Close"]">
            <svg class="ph-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
    </div>

    @* Navigation Links *@
    <div class="ph-sidebar-nav flex-grow-1 overflow-auto p-3">
        <ul class="nav nav-pills flex-column gap-1 mb-auto">
            @* Core / Dashboard *@
            <li class="nav-item">
                <a asp-controller="Home" asp-action="Index" class="nav-link @(IsActive("Home", "Index") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    <span>@Loc["Dashboard"]</span>
                </a>
            </li>

            @* Section: Inventory & Procurement *@
            <li class="ph-nav-heading text-uppercase text-secondary fw-bold px-3 pt-3 pb-1" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                @Loc["Inventory"]
            </li>

            <li class="nav-item">
                <a asp-controller="Products" asp-action="Index" class="nav-link @(IsActive("Products") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path><path d="m8.5 8.5 7 7"></path></svg>
                    <span>@Loc["Products"]</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Categories" asp-action="Index" class="nav-link @(IsActive("Categories") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"></path></svg>
                    <span>@Loc["Categories"]</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Locations" asp-action="Index" class="nav-link @(IsActive("Locations") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    <span>@Loc["Locations"]</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Inventory" asp-action="Index" class="nav-link @(IsActive("Inventory") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    <span>@Loc["Nav_Inventory"]</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Suppliers" asp-action="Index" class="nav-link @(IsActive("Suppliers") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    <span>@Loc["Suppliers"]</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Purchases" asp-action="Index" class="nav-link @(IsActive("Purchases") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <span>@Loc["Purchases"]</span>
                </a>
            </li>

            @* Section: Sales & Customers *@
            <li class="ph-nav-heading text-uppercase text-secondary fw-bold px-3 pt-3 pb-1" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                @Loc["Sales"]
            </li>

            <li class="nav-item">
                <a asp-controller="Sales" asp-action="Index" class="nav-link @(IsActive("Sales") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    <span>@Loc["Sales"]</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Customers" asp-action="Index" class="nav-link @(IsActive("Customers") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    <span>@Loc["Customers"]</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Returns" asp-action="Index" class="nav-link @(IsActive("Returns") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
                    <span>@Loc["Returns"]</span>
                </a>
            </li>

            @* Section: Financial & Reports *@
            <li class="ph-nav-heading text-uppercase text-secondary fw-bold px-3 pt-3 pb-1" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                @Loc["Expenses"]
            </li>

            <li class="nav-item">
                <a asp-controller="Expenses" asp-action="Index" class="nav-link @(IsActive("Expenses") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    <span>@Loc["Expenses"]</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Reports" asp-action="Index" class="nav-link @(IsActive("Reports") ? "active" : "") d-flex align-items-center gap-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                    <span>@Loc["Reports"]</span>
                </a>
            </li>

            @* Section: Administration (Role-gated: Admin only) *@
            @if (CurrentUser.IsAdmin)
            {
                <li class="ph-nav-heading text-uppercase text-secondary fw-bold px-3 pt-3 pb-1" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                    @Loc["Users"]
                </li>

                <li class="nav-item">
                    <a asp-controller="Users" asp-action="Index" class="nav-link @(IsActive("Users") ? "active" : "") d-flex align-items-center gap-3">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span>@Loc["Users"]</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="AuditLogs" asp-action="Index" class="nav-link @(IsActive("AuditLogs") ? "active" : "") d-flex align-items-center gap-3">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                        <span>@Loc["AuditLogs"]</span>
                    </a>
                </li>
            }
        </ul>
    </div>

    @* Sidebar Footer with current user profile card *@
    <div class="ph-sidebar-footer p-3 border-top border-secondary border-opacity-25 bg-black bg-opacity-20">
        @if (CurrentUser.IsAuthenticated)
        {
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2 overflow-hidden">
                    <div class="ph-avatar bg-teal-subtle text-teal rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 0.85rem;">
                        @(CurrentUser.DisplayName?.Substring(0, Math.Min(1, CurrentUser.DisplayName.Length)).ToUpper() ?? "U")
                    </div>
                    <div class="overflow-hidden">
                        <div class="small fw-bold text-white text-truncate">@CurrentUser.DisplayName</div>
                        <div class="text-secondary small" style="font-size: 0.72rem;">
                            @(CurrentUser.IsAdmin ? Loc["Role_Admin"] : Loc["Role_Pharmacist"])
                        </div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-link text-secondary p-1" title="@Loc["Logout"]">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    </button>
                </form>
            </div>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-teal w-100 d-flex align-items-center justify-content-center gap-2">
                <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
                <span>@Loc["Login"]</span>
            </a>
        }
    </div>
</aside>
