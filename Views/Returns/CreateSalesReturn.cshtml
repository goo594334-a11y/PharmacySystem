@model PharmacySystem.Models.ViewModels.Returns.CreateSalesReturnViewModel
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["ProcessSalesReturn"];
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">@Loc["ProcessSalesReturn"]</h4>
            <p class="text-muted small mb-0">#@Model.SaleInvoiceNumber</p>
        </div>
        <a asp-action="Sales" class="btn btn-outline-secondary">@Loc["BackToList"]</a>
    </div>

    <form asp-action="CreateSalesReturn" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SaleId" />
        <input type="hidden" asp-for="SaleInvoiceNumber" />

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3" role="alert"></div>

        <div class="card border-0 shadow-sm ph-card mb-4">
            <div class="card-body p-4">
                <div class="mb-3">
                    <label asp-for="Reason" class="form-label required">@Loc["ReturnReason"]</label>
                    <input asp-for="Reason" class="form-control" placeholder="@Loc["ReasonPlaceholder"]" autofocus />
                    <span asp-validation-for="Reason" class="field-validation-error"></span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm ph-card overflow-hidden mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="card-title mb-0 fw-bold">@Loc["SelectItemsToReturn"]</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Loc["Product"]</th>
                            <th>@Loc["BatchNumber"]</th>
                            <th>@Loc["SoldQuantity"]</th>
                            <th>@Loc["UnitPrice"]</th>
                            <th style="width: 15%;">@Loc["QuantityToReturn"]</th>
                            <th style="width: 20%;" class="pe-4 text-center">@Loc["ReturnDisposition"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">
                                    @Model.Items[i].ProductName
                                    <input type="hidden" asp-for="Items[i].SaleItemId" />
                                    <input type="hidden" asp-for="Items[i].ProductName" />
                                    <input type="hidden" asp-for="Items[i].BatchId" />
                                    <input type="hidden" asp-for="Items[i].BatchNumber" />
                                    <input type="hidden" asp-for="Items[i].SoldQuantity" />
                                    <input type="hidden" asp-for="Items[i].UnitPrice" />
                                </td>
                                <td><code>@Model.Items[i].BatchNumber</code></td>
                                <td class="fw-bold">@Model.Items[i].SoldQuantity</td>
                                <td>@Model.Items[i].UnitPrice.ToString("C2")</td>
                                <td>
                                    <input asp-for="Items[i].QuantityToReturn" type="number" class="form-control" min="0" max="@Model.Items[i].SoldQuantity" />
                                </td>
                                <td class="pe-4 text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" asp-for="Items[i].ReturnToStock" id="returnStockSwitch-@i" />
                                        <label class="form-check-label small" for="returnStockSwitch-@i">
                                            @Loc["RestockIfValid"]
                                        </label>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Sales" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
            <button type="submit" class="btn btn-danger px-4 fw-semibold">@Loc["ConfirmReturnAndRefund"]</button>
        </div>
    </form>
</div>
