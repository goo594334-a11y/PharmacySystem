@model PharmacySystem.Models.ViewModels.Products.EditProductViewModel
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["EditProduct"];
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                        <span class="ph-brand-icon bg-teal text-white rounded p-2 d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <svg class="ph-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path><path d="m8.5 8.5 7 7"></path></svg>
                        </span>
                        <span>@Loc["EditProduct"]: @Model.Name</span>
                    </h4>
                    <p class="text-muted small mb-0">@Loc["EditProductSubtitle"]</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                        <span>@Loc["BackToList"]</span>
                    </a>
                </div>
            </div>

            <form asp-action="Edit" method="post" id="editProductForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm mb-4" role="alert"></div>

                <!-- SECTION 1: Basic Information -->
                <div class="card border-0 shadow-sm ph-card mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <span class="badge bg-teal-subtle text-teal rounded-circle p-1" style="width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center;">1</span>
                            <span>@Loc["BasicInformation"]</span>
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <!-- Product Name -->
                            <div class="col-12 col-md-8">
                                <label asp-for="Name" class="form-label required fw-semibold">@Loc["ProductName"]</label>
                                <input asp-for="Name" class="form-control form-control-lg" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <!-- Barcode -->
                            <div class="col-12 col-md-4">
                                <label asp-for="Barcode" class="form-label fw-semibold">@Loc["Barcode"]</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light text-muted border-end-0">
                                        <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="7" y1="8" x2="7" y2="16"></line><line x1="10" y1="8" x2="10" y2="16"></line><line x1="14" y1="8" x2="14" y2="16"></line><line x1="17" y1="8" x2="17" y2="16"></line></svg>
                                    </span>
                                    <input asp-for="Barcode" class="form-control" placeholder="@Loc["BarcodePlaceholder"]" id="productBarcodeInput" />
                                </div>
                                <span asp-validation-for="Barcode" class="text-danger small"></span>
                            </div>

                            <!-- Selling Price -->
                            <div class="col-12 col-md-4">
                                <label asp-for="SellingPrice" class="form-label required fw-semibold">@Loc["SellingPrice"]</label>
                                <div class="input-group">
                                    <input asp-for="SellingPrice" id="productSellingPrice" class="form-control" type="number" step="0.01" min="0.01" required />
                                    <span class="input-group-text bg-light text-muted px-3">@Loc["CurrencySymbol"]</span>
                                </div>
                                <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                                <div class="form-text small text-muted">@Loc["BaseUnitDescription"]</div>
                            </div>

                            <!-- Minimum Stock Level -->
                            <div class="col-12 col-md-4">
                                <label asp-for="MinimumStockLevel" class="form-label required fw-semibold">@Loc["MinimumStockLevel"]</label>
                                <input asp-for="MinimumStockLevel" class="form-control" type="number" min="0" required />
                                <span asp-validation-for="MinimumStockLevel" class="text-danger small"></span>
                            </div>

                            <!-- Active Switch -->
                            <div class="col-12 col-md-4 d-flex align-items-center pt-md-3">
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="productIsActiveSwitch" />
                                    <label class="form-check-label fw-semibold" for="productIsActiveSwitch">@Loc["Active"]</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 2: Classification & Dosage Form -->
                <div class="card border-0 shadow-sm ph-card mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <span class="badge bg-teal-subtle text-teal rounded-circle p-1" style="width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center;">2</span>
                            <span>@Loc["ProductClassification"]</span>
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <!-- Category Selection + Quick Add -->
                            <div class="col-12 col-lg-6">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label asp-for="CategoryId" class="form-label required fw-semibold mb-0">@Loc["Category"]</label>
                                    <button type="button" class="btn btn-sm btn-link text-teal p-0 text-decoration-none fw-semibold" data-bs-toggle="modal" data-bs-target="#quickCategoryModal">
                                        + @Loc["QuickAddCategory"]
                                    </button>
                                </div>
                                <select asp-for="CategoryId" class="form-select form-select-lg" asp-items="@ViewBag.Categories" id="productCategorySelect" required></select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>

                                <!-- Category Suggestions Pills -->
                                <div class="mt-2">
                                    <span class="text-muted small d-block mb-1">@Loc["CategoryQuickSuggestions"]:</span>
                                    <div class="d-flex flex-wrap gap-1" id="categorySuggestionsGroup">
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 category-pill" data-cat-name="مسكنات الآلام" data-cat-en="Analgesics (Painkillers)">@Loc["Category_Analgesics"]</button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 category-pill" data-cat-name="مضادات حيوية" data-cat-en="Antibiotics">@Loc["Category_Antibiotics"]</button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 category-pill" data-cat-name="فيتامينات ومكملات غذائية" data-cat-en="Vitamins &amp; Supplements">@Loc["Category_Vitamins"]</button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 category-pill" data-cat-name="أدوية الجهاز الهضمي" data-cat-en="Digestive System">@Loc["Category_Digestive"]</button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 category-pill" data-cat-name="أدوية القلب والأوعية الدموية" data-cat-en="Cardiovascular">@Loc["Category_Cardiovascular"]</button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 category-pill" data-cat-name="أدوية الحساسية" data-cat-en="Allergy">@Loc["Category_Allergy"]</button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 category-pill" data-cat-name="أدوية الجهاز التنفسي" data-cat-en="Respiratory">@Loc["Category_Respiratory"]</button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 category-pill" data-cat-name="مستلزمات طبية" data-cat-en="Medical Supplies">@Loc["Category_MedicalSupplies"]</button>
                                    </div>
                                </div>
                            </div>

                            <!-- Dosage Form -->
                            <div class="col-12 col-lg-6">
                                <label asp-for="DosageForm" class="form-label fw-semibold mb-1">@Loc["DosageForm"]</label>
                                <input type="hidden" asp-for="DosageForm" id="dosageFormHiddenInput" value="@(Model.DosageForm ?? "أقراص / Tablets")" />
                                
                                <div class="d-flex flex-wrap gap-1 mb-2" id="dosageFormsContainer">
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="أقراص / Tablets" data-preset="tablets">
                                        💊 @Loc["DosageForm_Tablets"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="كبسولات / Capsules" data-preset="capsules">
                                        💊 @Loc["DosageForm_Capsules"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="شراب / Syrup" data-preset="syrup">
                                        🍶 @Loc["DosageForm_Syrup"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="حقن / Injection" data-preset="injection">
                                        💉 @Loc["DosageForm_Injection"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="أمبول / Ampoule" data-preset="ampoule">
                                        🧪 @Loc["DosageForm_Ampoule"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="فيال / Vial" data-preset="vial">
                                        🧪 @Loc["DosageForm_Vial"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="كريم / Cream" data-preset="cream">
                                        🧴 @Loc["DosageForm_Cream"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="مرهم / Ointment" data-preset="ointment">
                                        🧴 @Loc["DosageForm_Ointment"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="قطرات / Drops" data-preset="drops">
                                        💧 @Loc["DosageForm_Drops"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="أكياس وفوار / Sachets" data-preset="sachets">
                                        📦 @Loc["DosageForm_Sachet"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="بخاخ / Spray" data-preset="spray">
                                        💨 @Loc["DosageForm_Spray"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="مستلزمات طبية / Medical Supplies" data-preset="supplies">
                                        🩹 @Loc["DosageForm_MedicalSupplies"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dosage-form-btn" data-form="أخرى / Other" data-preset="custom">
                                        ✨ @Loc["DosageForm_Custom"]
                                    </button>
                                </div>

                                <div id="customDosageFormDiv" class="input-group input-group-sm d-none mt-2">
                                    <input type="text" id="customDosageFormInput" class="form-control" placeholder="أدخل الشكل الصيدلاني المخصص..." />
                                    <button type="button" id="applyCustomDosageFormBtn" class="btn btn-teal">تطبيق</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 3: Smart Packaging & Units -->
                <div class="card border-0 shadow-sm ph-card mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <span class="badge bg-teal-subtle text-teal rounded-circle p-1" style="width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center;">3</span>
                            <span>@Loc["PackagingUnits"]</span>
                        </h6>
                    </div>

                    <div class="card-body p-4">
                        <!-- Primary Splitting Control Toggle -->
                        <div class="p-3 rounded-3 mb-4 border" style="background-color: #f8fafc;">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                <div>
                                    <label class="form-check-label fw-bold text-dark fs-6 d-block mb-1" for="canSplitProductSwitch">
                                        @Loc["CanBeSoldInSmallerUnits"]
                                    </label>
                                    <span class="text-muted small">
                                        @Loc["CanBeSoldInSmallerUnitsHint"]
                                    </span>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input fs-4" type="checkbox" role="switch" id="canSplitProductSwitch" @(Model.SellFullPackageOnly ? "" : "checked") />
                                </div>
                            </div>
                        </div>

                        <!-- Hidden fields bound to ViewModel -->
                        <input type="hidden" asp-for="SellFullPackageOnly" id="sellFullPackageOnlyHidden" />
                        <input type="hidden" asp-for="BaseUnitName" id="baseUnitNameHidden" />
                        <input type="hidden" asp-for="UnitsJson" id="unitsJsonHidden" />

                        <!-- Case A: Non-Splittable (Sell Full Package Only) -->
                        <div id="nonSplittableContainer" class="@(Model.SellFullPackageOnly ? "" : "d-none")">
                            <div class="card border border-teal-subtle bg-teal-subtle bg-opacity-10 rounded-3 p-4 mb-2">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-circle bg-white p-2 text-teal shadow-xs d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                                        <svg class="ph-icon" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold text-dark mb-1">@Loc["SoldAsFullPackageOnlyTitle"]</h6>
                                        <p class="text-muted small mb-3">@Loc["SoldAsFullPackageOnlyDescription"]</p>
                                        <div class="d-flex flex-wrap gap-3 align-items-center">
                                            <div class="bg-white border rounded px-3 py-2 shadow-xs">
                                                <span class="text-muted small d-block">@Loc["MainPackageName"]</span>
                                                <span class="fw-bold text-dark fs-6" id="nonSplittableUnitBadge">@(Model.BaseUnitName ?? "علبة / Box")</span>
                                            </div>
                                            <div class="bg-white border rounded px-3 py-2 shadow-xs">
                                                <span class="text-muted small d-block">@Loc["MainPackagePrice"]</span>
                                                <span class="fw-bold text-teal fs-6" id="nonSplittablePriceBadge">@Model.SellingPrice.ToString("N2") @Loc["EGP"]</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Case B: Splittable (Guided Breakdown & Smaller Units) -->
                        <div id="splittableContainer" class="@(Model.SellFullPackageOnly ? "d-none" : "")">
                            <!-- Live Packaging Hierarchy Preview Banner -->
                            <div class="p-3 bg-light rounded-3 border mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold small text-teal d-flex align-items-center gap-1">
                                        <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                                        <span>@Loc["FormulaPreview"]</span>
                                    </span>
                                    <span class="badge bg-white text-secondary border small" id="packagingPresetBadge">هيكل الوحدات الحالي</span>
                                </div>
                                <div class="d-flex align-items-center flex-wrap gap-2 py-2" id="packagingFlowVisual"></div>
                                <div class="small fw-semibold text-dark mt-2 border-top pt-2" id="packagingEquationText"></div>
                            </div>

                            <!-- Main Package (Top Unit) Row -->
                            <div class="row g-3 mb-3 p-3 bg-white border rounded-3 align-items-center">
                                <div class="col-12 col-md-5">
                                    <label class="form-label fw-semibold small mb-1">@Loc["MainPackageName"]</label>
                                    <input type="text" class="form-control" id="mainPackageNameInput" value="علبة / Box" placeholder="علبة / Box..." />
                                    <div class="form-text small text-muted">اسم العبوة الكبرى المشتراة والمباعة بالكامل</div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-semibold small mb-1">@Loc["MainPackagePrice"]</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control bg-light fw-bold text-teal" id="mainPackagePriceDisplay" readonly />
                                        <span class="input-group-text small">@Loc["EGP"]</span>
                                    </div>
                                    <div class="form-text small text-muted">مربوط بسعر البيع الرئيسي للصنف</div>
                                </div>
                                <div class="col-12 col-md-3">
                                    <label class="form-label fw-semibold small mb-1">إتاحة البيع بالعبوة</label>
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" id="mainPackageAllowSale" checked disabled />
                                        <label class="form-check-label small" for="mainPackageAllowSale">متاح دائماً</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Dynamic Guided Packaging Cards by Selected Dosage Form -->
                            <div id="guidedPackagingCards" class="d-flex flex-column gap-3 mb-3">
                                <!-- Populated dynamically by JS -->
                            </div>

                            <!-- Custom Additional Smaller Unit Section -->
                            <div class="border-top pt-3 mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-semibold small text-muted">وحدات تجزئة إضافية إن وجدت:</span>
                                    <button type="button" class="btn btn-sm btn-outline-teal d-inline-flex align-items-center gap-1" id="addCustomUnitBtn">
                                        <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                        <span>@Loc["AddCustomSmallerUnit"]</span>
                                    </button>
                                </div>
                                <div id="customUnitsList" class="d-flex flex-column gap-2"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 4: Description -->
                <div class="card border-0 shadow-sm ph-card mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <span class="badge bg-teal-subtle text-teal rounded-circle p-1" style="width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center;">4</span>
                            <span>@Loc["Description"]</span>
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <label asp-for="Description" class="form-label fw-semibold">@Loc["Description"] (@Loc["Optional"])</label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="@Loc["DescriptionPlaceholder"]"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Form Action Buttons -->
                <div class="d-flex justify-content-end align-items-center gap-2 mb-5">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">@Loc["Cancel"]</a>
                    <button type="submit" class="btn btn-teal px-5 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2" id="submitProductBtn">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>@Loc["Save"]</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- QUICK ADD CATEGORY MODAL -->
<div class="modal fade" id="quickCategoryModal" tabindex="-1" aria-labelledby="quickCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold text-dark fs-6" id="quickCategoryModalLabel">+ @Loc["QuickAddCategory"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label required fw-semibold small">@Loc["CategoryName"]</label>
                    <input type="text" id="quickCategoryNameInput" class="form-control" placeholder="مثال: مسكنات، مضادات حيوية..." required />
                    <div class="text-danger small mt-1 d-none" id="quickCategoryError"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">@Loc["Description"] (@Loc["Optional"])</label>
                    <textarea id="quickCategoryDescInput" class="form-control" rows="2" placeholder="وصف الفئة..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="button" class="btn btn-sm btn-teal fw-semibold px-3" id="saveQuickCategoryBtn">
                    @Loc["Save"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // DOM Elements
        const form = document.getElementById('editProductForm');
        const mainSellingPriceInput = document.getElementById('productSellingPrice');
        const mainBarcodeInput = document.getElementById('productBarcodeInput');
        const dosageFormHiddenInput = document.getElementById('dosageFormHiddenInput');

        const canSplitProductSwitch = document.getElementById('canSplitProductSwitch');
        const sellFullPackageOnlyHidden = document.getElementById('sellFullPackageOnlyHidden');
        const baseUnitNameHidden = document.getElementById('baseUnitNameHidden');
        const unitsJsonHidden = document.getElementById('unitsJsonHidden');

        const nonSplittableContainer = document.getElementById('nonSplittableContainer');
        const splittableContainer = document.getElementById('splittableContainer');
        const nonSplittableUnitBadge = document.getElementById('nonSplittableUnitBadge');
        const nonSplittablePriceBadge = document.getElementById('nonSplittablePriceBadge');

        const mainPackageNameInput = document.getElementById('mainPackageNameInput');
        const mainPackagePriceDisplay = document.getElementById('mainPackagePriceDisplay');
        const packagingPresetBadge = document.getElementById('packagingPresetBadge');
        const packagingFlowVisual = document.getElementById('packagingFlowVisual');
        const packagingEquationText = document.getElementById('packagingEquationText');
        const guidedPackagingCards = document.getElementById('guidedPackagingCards');
