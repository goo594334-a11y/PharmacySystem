@model PharmacySystem.Models.ViewModels.Dashboard.DashboardViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@using PharmacySystem.Services.Auth
@inject IStringLocalizer<SharedResource> Loc
@inject ICurrentUserService CurrentUser

@{
    ViewData["Title"] = Loc["Dashboard"];
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var userName = CurrentUser.DisplayName ?? (Model.IsAdmin ? "Admin" : "Pharmacist");
    var todayFormatted = DateTime.Now.ToString("dddd, MMM d, yyyy", CultureInfo.CurrentUICulture);
}

@* 1. Top Welcome Banner & Action Button (matching Figma reference) *@
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 small fw-semibold" style="font-size: 0.72rem;">
                ● @Loc["StoreOpen"]
            </span>
            <span class="text-muted small" style="font-size: 0.78rem;">@todayFormatted</span>
        </div>
        <h3 class="fw-bold text-dark mb-0 fs-4">
            @(currentCulture == "ar" ? $"صباح الخير، {userName}" : $"Good morning, {userName}.")
        </h3>
        <p class="text-muted small mb-0">@Loc["HeresHowPharmacyIsDoingToday"]</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="dropdown">
            <button class="btn btn-sm btn-light border dropdown-toggle px-3 py-2 text-secondary" type="button" data-bs-toggle="dropdown">
                <svg class="ph-icon me-1 text-muted" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <span>@DateTime.Now.ToString("MMM d, yyyy")</span>
            </button>
        </div>
        <a asp-controller="Sales" asp-action="New" class="btn btn-teal shadow-sm d-flex align-items-center gap-2 py-2 px-3 rounded-3">
            <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span class="fw-semibold">@Loc["NewSale"]</span>
        </a>
    </div>
</div>

@* 2. Top Metric Cards Row (4 cards matching Figma: Today's Sales, Transactions, Products in stock, Expiring soon) *@
<div class="row g-3 mb-4">
    @* Card 1: Today's Sales *@
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card ph-card h-100 p-3 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium" style="font-size: 0.82rem;">@Loc["TodaySales"]</span>
                <span class="badge bg-light text-muted p-1 rounded-2 border">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                </span>
            </div>
            <div class="fs-3 fw-bold text-dark mb-1">
                @Model.TodaySalesAmount.ToString("N2") <span class="fs-6 fw-normal text-muted">@Loc["CurrencySymbol"]</span>
            </div>
            <div class="d-flex align-items-center gap-1 small text-success mt-auto" style="font-size: 0.78rem;">
                <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                <span>+@Model.TodaySalesCount @Loc["SalesCompletedToday"]</span>
            </div>
        </div>
    </div>

    @* Card 2: Transactions *@
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card ph-card h-100 p-3 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium" style="font-size: 0.82rem;">@Loc["Transactions"]</span>
                <span class="badge bg-light text-muted p-1 rounded-2 border">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                </span>
            </div>
            <div class="fs-3 fw-bold text-dark mb-1">
                @Model.TodaySalesCount
            </div>
            <div class="small text-muted mt-auto" style="font-size: 0.78rem;">
                <span>@Loc["IncludesPrescriptionsAndOtcs"]</span>
            </div>
        </div>
    </div>

    @* Card 3: Products in stock *@
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card ph-card h-100 p-3 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium" style="font-size: 0.82rem;">@Loc["ProductsInStock"]</span>
                <span class="badge bg-light text-muted p-1 rounded-2 border">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                </span>
            </div>
            <div class="fs-3 fw-bold text-dark mb-1">
                @Model.TotalInventoryQuantity
            </div>
            <div class="small text-muted mt-auto" style="font-size: 0.78rem;">
                <span class="fw-semibold text-dark">@Model.TotalProductsCount</span> @Loc["ActiveProductsTracked"]
            </div>
        </div>
    </div>

    @* Card 4: Expiring soon (or Today's Profit for Admin) *@
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card ph-card h-100 p-3 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium" style="font-size: 0.82rem;">
                    @(Model.IsAdmin ? Loc["TodayProfit"] : Loc["ExpiringSoon"])
                </span>
                <span class="badge @(Model.IsAdmin ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") p-1 rounded-2 border">
                    @if (Model.IsAdmin)
                    {
                        <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                    }
                    else
                    {
                        <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    }
                </span>
            </div>
            <div class="fs-3 fw-bold @(Model.IsAdmin ? "text-success" : "text-dark") mb-1">
                @if (Model.IsAdmin)
                {
                    <span>@Model.TodayProfit.ToString("N2") <span class="fs-6 fw-normal text-muted">@Loc["CurrencySymbol"]</span></span>
                }
                else
                {
                    <span>@Model.NearExpiryCount</span>
                }
            </div>
            <div class="small @(Model.IsAdmin ? "text-success" : "text-danger") mt-auto" style="font-size: 0.78rem;">
                @if (Model.IsAdmin)
                {
                    <span class="fw-semibold">@Loc["NetGain"]</span>
                }
                else
                {
                    <a asp-controller="Inventory" asp-action="Expiry" class="text-decoration-none text-danger fw-semibold">
                        @Loc["Within90Days"] &rarr;
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@* Financial Reconciliation & Payment Breakdown Row *@
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card ph-card h-100 p-3 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-secondary small fw-bold">@Loc["NetSalesToday"]</span>
                <span class="badge bg-teal-subtle text-teal">@Loc["NetRevenue"]</span>
            </div>
            <div class="fs-4 fw-bold text-teal mb-1">
                @Model.TodayNetSales.ToString("N2") <span class="fs-6 fw-normal text-muted">@Loc["CurrencySymbol"]</span>
            </div>
            <div class="small text-muted" style="font-size: 0.78rem;">
                <span>@Loc["GrossSales"]: @Model.TodaySalesAmount.ToString("N2")</span> | 
                <span class="text-danger">@Loc["Returns"]: -@Model.TodaySalesReturnsAmount.ToString("N2")</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card ph-card h-100 p-3 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-secondary small fw-bold">@Loc["MonthlyNetSales"]</span>
                <span class="badge bg-primary-subtle text-primary">@DateTime.Now.ToString("MMMM yyyy")</span>
            </div>
            <div class="fs-4 fw-bold text-dark mb-1">
                @Model.MonthNetSales.ToString("N2") <span class="fs-6 fw-normal text-muted">@Loc["CurrencySymbol"]</span>
            </div>
            <div class="small text-muted" style="font-size: 0.78rem;">
                <span>@Loc["MonthlyGross"]: @Model.MonthSalesAmount.ToString("N2")</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card ph-card h-100 p-3 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-secondary small fw-bold">@Loc["PaymentBreakdownToday"]</span>
                <span class="badge bg-secondary-subtle text-secondary">@Loc["Methods"]</span>
            </div>
            <div class="d-flex flex-wrap gap-2 pt-1" style="font-size: 0.78rem;">
                <span class="badge bg-light text-dark border">@Loc["PaymentMethod_Cash"]: @Model.TodayCashTotal.ToString("N0")</span>
                <span class="badge bg-light text-dark border">@Loc["PaymentMethod_Card"]: @Model.TodayCardTotal.ToString("N0")</span>
                <span class="badge bg-light text-dark border">@Loc["PaymentMethod_VodafoneCash"]: @Model.TodayVodafoneCashTotal.ToString("N0")</span>
                @if (Model.TodaySplitTotal > 0)
                {
                    <span class="badge bg-light text-dark border">@Loc["PaymentMethod_Split"]: @Model.TodaySplitTotal.ToString("N0")</span>
                }
            </div>
        </div>
    </div>
</div>

@* 3. Middle Section: Sales Performance Line Chart & Sales by Category Donut Chart *@
<div class="row g-4 mb-4">
    @* Left: Sales Performance Chart *@
    <div class="col-12 col-xl-8">
        <div class="card ph-card h-100 border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold text-dark mb-1">@Loc["SalesPerformance"]</h6>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="fs-4 fw-bold text-dark">@Model.WeeklySalesTotal.ToString("N2") @Loc["CurrencySymbol"]</span>
                    </div>
                </div>
                <div>
                    <span class="badge bg-light text-secondary border px-2 py-1 small">@Loc["Last7Days"]</span>
                </div>
            </div>
            <div class="card-body px-4 pb-4 pt-2">
                <div style="position: relative; height: 260px;">
                    <canvas id="salesPerformanceChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    @* Right: Sales by Category Donut Chart *@
    <div class="col-12 col-xl-4">
        <div class="card ph-card h-100 border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold text-dark mb-0">@Loc["SalesByCategory"]</h6>
                    <span class="text-muted small" style="font-size: 0.75rem;">@Loc["RevenueShareLast7Days"]</span>
                </div>
            </div>
            <div class="card-body px-4 py-3 d-flex flex-column align-items-center justify-content-center">
                <div style="position: relative; width: 170px; height: 170px;" class="mb-3">
                    <canvas id="categoryDonutChart"></canvas>
                    <div class="position-absolute top-50 start-50 translate-middle text-center">
                        <span class="fs-4 fw-bold text-dark d-block lh-1">@Model.TodaySalesCount</span>
                        <span class="text-muted small" style="font-size: 0.68rem;">@Loc["Transactions"]</span>
                    </div>
                </div>

                @* Category List Legend *@
                <div class="w-100 mt-2" style="max-height: 120px; overflow-y: auto;">
                    @if (Model.CategorySales.Count == 0)
                    {
                        <div class="text-center text-muted small py-2">
                            <span>@Loc["NoSalesRecordedYet"]</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var cat in Model.CategorySales)
                        {
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light small">
                                <span class="text-secondary fw-medium">@cat.CategoryName</span>
                                <span class="fw-bold text-dark">@cat.Percentage%</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* 4. Lower Section: Recent Sales & Alerts Grid *@
<div class="row g-4 mb-4">
    @* Recent Sales Activity *@
    <div class="col-12 col-lg-7">
        <div class="card ph-card h-100">
            <div class="card-header ph-card-header d-flex justify-content-between align-items-center">
                <h5 class="fw-bold fs-6 mb-0 text-dark">@Loc["RecentSales"]</h5>
                <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-link text-decoration-none p-0">@Loc["View"] &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentSales.Count == 0)
                {
                    <div class="p-4 text-center text-muted small">@Loc["NoSalesFound"]</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table ph-table mb-0">
                            <thead>
                                <tr>
                                    <th>@Loc["InvoiceNumber"]</th>
                                    <th>@Loc["Customer"]</th>
                                    <th>@Loc["Date"]</th>
                                    <th>@Loc["TotalAmount"]</th>
                                    <th>@Loc["PaymentMethod"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sale in Model.RecentSales)
                                {
                                    <tr>
                                        <td class="fw-semibold text-primary">@sale.InvoiceNumber</td>
                                        <td>@(sale.Customer?.Name ?? Loc["WalkInCustomer"])</td>
                                        <td class="text-muted small">@sale.SaleDate.ToLocalTime().ToString("g")</td>
                                        <td class="fw-bold text-dark">@sale.TotalAmount.ToString("N2") @Loc["CurrencySymbol"]</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @sale.PaymentMethod.ToString()
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Inventory Risk & Alerts *@
    <div class="col-12 col-lg-5">
        <div class="card ph-card h-100">
            <div class="card-header ph-card-header d-flex justify-content-between align-items-center">
                <h5 class="fw-bold fs-6 mb-0 text-dark">@Loc["StockAlerts"]</h5>
                <a asp-controller="Inventory" asp-action="LowStock" class="btn btn-sm btn-link text-decoration-none p-0">@Loc["View"] &rarr;</a>
            </div>
            <div class="card-body p-3">
                @if (Model.LowStockProducts.Count == 0 && Model.NearExpiryBatches.Count == 0 && Model.ExpiredBatches.Count == 0)
                {
                    <div class="text-center py-4 text-muted small">
                        <svg class="ph-icon mb-2 text-success" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        <div>@Loc["AllStockLevelsHealthy"]</div>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2" style="max-height: 280px; overflow-y: auto;">
                        @foreach (var low in Model.LowStockProducts)
                        {
                            <div class="p-2 border rounded-3 bg-warning-subtle d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold small text-dark">@low.ProductName</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @Loc["MinimumStockLevel"]: @low.MinimumStockLevel
                                    </div>
                                </div>
                                <span class="badge bg-warning text-dark">
                                    @low.AvailableQuantity @Loc["AvailableQuantity"]
                                </span>
                            </div>
                        }

                        @foreach (var expiry in Model.NearExpiryBatches)
                        {
                            <div class="p-2 border rounded-3 bg-danger-subtle d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold small text-dark">@expiry.ProductName</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @Loc["Batch"]: @expiry.BatchNumber | @Loc["Location"]: @expiry.LocationCode
                                    </div>
                                </div>
                                <span class="badge bg-danger">
                                    @expiry.RemainingDays @Loc["Days"]
                                </span>
                            </div>
                        }

                        @foreach (var expired in Model.ExpiredBatches)
                        {
                            <div class="p-2 border rounded-3 bg-dark-subtle d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold small text-dark">@expired.ProductName</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @Loc["Batch"]: @expired.BatchNumber (@Loc["Expired"])
                                    </div>
                                </div>
                                <span class="badge bg-dark">
                                    @expired.QuantityOnHand @Loc["Units"]
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* 5. Admin Recent Purchases & Audit Activity *@
@if (Model.IsAdmin)
{
    <div class="row g-4 mb-4">
        @* Recent Purchases *@
        <div class="col-12 col-lg-6">
            <div class="card ph-card h-100">
                <div class="card-header ph-card-header d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold fs-6 mb-0 text-dark">@Loc["RecentPurchases"]</h5>
                    <a asp-controller="Purchases" asp-action="Index" class="btn btn-sm btn-link text-decoration-none p-0">@Loc["View"] &rarr;</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentPurchases.Count == 0)
                    {
                        <div class="p-4 text-center text-muted small">@Loc["NoPurchasesFound"]</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table ph-table mb-0">
                                <thead>
                                    <tr>
                                        <th>@Loc["InvoiceNumber"]</th>
                                        <th>@Loc["Supplier"]</th>
                                        <th>@Loc["Date"]</th>
                                        <th>@Loc["TotalAmount"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var purchase in Model.RecentPurchases)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-primary">@purchase.InvoiceNumber</td>
                                            <td>@(purchase.Supplier?.Name ?? "-")</td>
                                            <td class="text-muted small">@purchase.PurchaseDate.ToLocalTime().ToString("g")</td>
                                            <td class="fw-bold text-dark">@purchase.TotalAmount.ToString("N2") @Loc["CurrencySymbol"]</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Recent Activity / Audit Log *@
        <div class="col-12 col-lg-6">
            <div class="card ph-card h-100">
                <div class="card-header ph-card-header d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold fs-6 mb-0 text-dark">@Loc["AuditLogs"]</h5>
                    <a asp-controller="AuditLogs" asp-action="Index" class="btn btn-sm btn-link text-decoration-none p-0">@Loc["View"] &rarr;</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentActivity.Count == 0)
                    {
                        <div class="p-4 text-center text-muted small">@Loc["NoRecentActivity"]</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table ph-table mb-0">
                                <thead>
                                    <tr>
                                        <th>@Loc["User"]</th>
                                        <th>@Loc["Actions"]</th>
                                        <th>@Loc["Category"]</th>
                                        <th>@Loc["Timestamp"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.RecentActivity)
                                    {
                                        <tr>
                                            <td class="fw-semibold">
                                                @(log.User?.FullName ?? Loc["System"])
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@log.Action</span>
                                            </td>
                                            <td class="text-muted small">
                                                @log.EntityName (#@log.EntityId)
                                            </td>
                                            <td class="text-muted small">
                                                @log.Timestamp.ToLocalTime().ToString("g")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function() {
            // 1. Sales Performance Line Chart
            const perfCtx = document.getElementById('salesPerformanceChart');
            if (perfCtx && typeof Chart !== 'undefined') {
                const perfLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendDates));
                const perfData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend));
                const isRtl = document.documentElement.dir === 'rtl';
                const currencySymbol = '@Loc["CurrencySymbol"]';

                const gradient = perfCtx.getContext('2d').createLinearGradient(0, 0, 0, 260);
                gradient.addColorStop(0, 'rgba(13, 115, 119, 0.25)');
                gradient.addColorStop(1, 'rgba(13, 115, 119, 0.01)');

                new Chart(perfCtx, {
                    type: 'line',
                    data: {
                        labels: perfLabels,
                        datasets: [{
                            label: '@Loc["Sales"]',
                            data: perfData,
                            borderColor: '#0d7377',
                            backgroundColor: gradient,
                            fill: true,
                            tension: 0.35,
                            borderWidth: 2.5,
                            pointRadius: 3,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#0d7377',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        rtl: isRtl,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(c) { return `${c.parsed.y.toLocaleString()} ${currencySymbol}`; }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(0,0,0,0.05)' },
                                ticks: {
                                    callback: function(v) { return v >= 1000 ? (v/1000) + 'k' : v; }
                                }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            // 2. Category Donut Chart
            const donutCtx = document.getElementById('categoryDonutChart');
            if (donutCtx && typeof Chart !== 'undefined') {
                const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategorySales.Select(c => c.CategoryName)));
                const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategorySales.Select(c => c.Percentage)));
                const hasData = catData && catData.length > 0 && catData.some(v => v > 0);

                new Chart(donutCtx, {
                    type: 'doughnut',
                    data: {
                        labels: hasData ? catLabels : ['@Loc["NoSalesRecordedYet"]'],
                        datasets: [{
                            data: hasData ? catData : [100],
                            backgroundColor: hasData ? ['#0d7377', '#14ffec', '#3b82f6', '#f59e0b', '#ec4899', '#8b5cf6'] : ['#e2e8f0'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                enabled: hasData,
                                callbacks: {
                                    label: function(c) { return `${c.label}: ${c.parsed}%`; }
                                }
                            }
                        }
                    }
                });
            }
        })();
    </script>
}
