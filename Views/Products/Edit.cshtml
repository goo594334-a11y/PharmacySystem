        function renderGuidedCards(presetKey, initialData = null) {
            currentPreset = presetKey;
            const config = FORM_PRESETS[presetKey] || FORM_PRESETS.tablets;
            packagingPresetBadge.textContent = config.badge;

            const mainPrice = parseFloat(mainSellingPriceInput.value) || 0;
            mainPackagePriceDisplay.value = mainPrice.toFixed(2);
            nonSplittablePriceBadge.textContent = `${mainPrice.toFixed(2)} ج.م`;

            if (initialData && initialData.mainPackageName) {
                mainPackageNameInput.value = initialData.mainPackageName;
            } else if (!mainPackageNameInput.dataset.userEdited) {
                mainPackageNameInput.value = config.mainPackage;
            }
            nonSplittableUnitBadge.textContent = mainPackageNameInput.value;

            let html = '';

            // Intermediate (Strip)
            if (config.hasIntermediate) {
                const interQty = initialData?.interQty || config.defaultIntermediateQty || 3;
                const interPrice = initialData?.interPrice !== undefined ? initialData.interPrice : (interQty > 0 ? (mainPrice / interQty).toFixed(2) : '0.00');
                const interAllow = initialData?.interAllowSale !== undefined ? initialData.interAllowSale : true;
                const interBarcode = initialData?.interBarcode || '';
                const suggestedInterPrice = interQty > 0 ? (mainPrice / interQty).toFixed(2) : '0.00';

                html += `
                    <div class="card border rounded-3 p-3 bg-white shadow-xs" id="intermediateUnitCard">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                <span class="badge bg-primary-subtle text-primary border">الوحدة المتوسطة</span>
                                <span>${config.intermediateName}</span>
                            </h6>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="interAllowSale" ${interAllow ? 'checked' : ''} />
                                <label class="form-check-label small fw-semibold" for="interAllowSale">إتاحة البيع بالكاشير</label>
                            </div>
                        </div>

                        <div class="row g-3 align-items-center">
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold mb-1">${config.intermediateQtyLabel}</label>
                                <input type="number" class="form-control text-center fw-bold text-teal" id="interQtyInput" value="${interQty}" min="1" step="1" required />
                                <div class="form-text small text-muted">عدد الشرائط بالعلبة الكاملة</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold mb-1 d-flex justify-content-between align-items-center">
                                    <span>سعر البيع (للشريط)</span>
                                    <span class="badge bg-light text-muted border small fw-normal" id="interSuggestedBadge">مقترح: ${suggestedInterPrice}</span>
                                </label>
                                <div class="input-group">
                                    <input type="number" class="form-control text-center fw-bold" id="interPriceInput" value="${interPrice}" step="0.01" min="0" placeholder="0.00" />
                                    <span class="input-group-text small">ج.م</span>
                                </div>
                                <div class="form-text small text-muted">قابل للتعديل بحرية</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold mb-1">باركود الشريط (اختياري)</label>
                                <input type="text" class="form-control" id="interBarcodeInput" value="${interBarcode}" placeholder="باركود مطبوع على الشريط..." />
                                <div class="form-text small text-muted">يسرع البيع بمسدس الباركود</div>
                            </div>
                        </div>
                    </div>
                `;
            }

            // Smallest (Tablet/Ampoule/etc)
            if (config.hasSmallest) {
                const isTabletsOrCapsules = config.hasIntermediate;
                const defaultCount = config.defaultSmallestQty || 1;
                const baseQty = initialData?.smallestQty || defaultCount;
                const sAllow = initialData?.smallestAllowSale !== undefined ? initialData.smallestAllowSale : (isTabletsOrCapsules ? false : true);
                const sPrice = initialData?.smallestPrice !== undefined ? initialData.smallestPrice : (baseQty > 0 ? (mainPrice / (isTabletsOrCapsules ? (3 * baseQty) : baseQty)).toFixed(2) : '0.00');
                const sBarcode = initialData?.smallestBarcode || '';
                const suggestedSmallPrice = baseQty > 0 ? (mainPrice / (isTabletsOrCapsules ? (3 * baseQty) : baseQty)).toFixed(2) : '0.00';

                html += `
                    <div class="card border rounded-3 p-3 bg-white shadow-xs" id="smallestUnitCard">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                <span class="badge bg-teal-subtle text-teal border">الوحدة الصغرى (الأساسية)</span>
                                <span>${config.smallestName}</span>
                            </h6>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="smallestAllowSale" ${sAllow ? 'checked' : ''} />
                                <label class="form-check-label small fw-semibold" for="smallestAllowSale">${config.smallestToggleLabel}</label>
                            </div>
                        </div>

                        <div class="row g-3 align-items-center" id="smallestFieldsContainer">
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold mb-1">${config.smallestQtyLabel}</label>
                                <input type="number" class="form-control text-center fw-bold text-teal" id="smallestQtyInput" value="${baseQty}" min="1" step="1" required />
                                <div class="form-text small text-muted">${isTabletsOrCapsules ? 'عدد الأقراص في الشريط الواحد' : 'العدد داخل العلبة'}</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold mb-1 d-flex justify-content-between align-items-center">
                                    <span>سعر البيع (للوحدة)</span>
                                    <span class="badge bg-light text-muted border small fw-normal" id="smallestSuggestedBadge">مقترح: ${suggestedSmallPrice}</span>
                                </label>
                                <div class="input-group">
                                    <input type="number" class="form-control text-center fw-bold" id="smallestPriceInput" value="${sPrice}" step="0.01" min="0" placeholder="0.00" />
                                    <span class="input-group-text small">ج.م</span>
                                </div>
                                <div class="form-text small text-muted">سعر بيع القرص / الوحدة المفردة</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold mb-1">باركود الوحدة (اختياري)</label>
                                <input type="text" class="form-control" id="smallestBarcodeInput" value="${sBarcode}" placeholder="باركود الوحدة الصغرى..." />
                                <div class="form-text small text-muted">اختياري</div>
                            </div>
                        </div>
                    </div>
                `;
            }

            guidedPackagingCards.innerHTML = html;
            attachCardEvents();
            updateLivePreview();
        }

        function attachCardEvents() {
            const interQtyInput = document.getElementById('interQtyInput');
            const interPriceInput = document.getElementById('interPriceInput');
            const interAllowSale = document.getElementById('interAllowSale');

            const smallestQtyInput = document.getElementById('smallestQtyInput');
            const smallestPriceInput = document.getElementById('smallestPriceInput');
            const smallestAllowSale = document.getElementById('smallestAllowSale');

            if (interPriceInput) {
                interPriceInput.addEventListener('input', function() {
                    this.dataset.manualEdited = "true";
                    updateSuggestedPrices(false);
                    updateLivePreview();
                });
            }

            if (smallestPriceInput) {
                smallestPriceInput.addEventListener('input', function() {
                    this.dataset.manualEdited = "true";
                    updateLivePreview();
                });
            }

            if (interQtyInput) {
                interQtyInput.addEventListener('input', () => {
                    updateSuggestedPrices(true);
                    updateLivePreview();
                });
            }

            if (smallestQtyInput) {
                smallestQtyInput.addEventListener('input', () => {
                    updateSuggestedPrices(true);
                    updateLivePreview();
                });
            }

            if (smallestAllowSale) {
                smallestAllowSale.addEventListener('change', () => {
                    updateLivePreview();
                });
            }

            if (interAllowSale) {
                interAllowSale.addEventListener('change', () => {
                    updateLivePreview();
                });
            }
        }

        function updateSuggestedPrices(autoOverride = false) {
            const mainPrice = parseFloat(mainSellingPriceInput.value) || 0;
            const config = FORM_PRESETS[currentPreset] || FORM_PRESETS.tablets;

            const interQtyInput = document.getElementById('interQtyInput');
            const interPriceInput = document.getElementById('interPriceInput');
            const interSuggestedBadge = document.getElementById('interSuggestedBadge');

            const smallestQtyInput = document.getElementById('smallestQtyInput');
            const smallestPriceInput = document.getElementById('smallestPriceInput');
            const smallestSuggestedBadge = document.getElementById('smallestSuggestedBadge');

            let currentInterPrice = 0;

            if (interQtyInput && interPriceInput) {
                const iQty = parseInt(interQtyInput.value) || 1;
                const suggestedInter = iQty > 0 ? (mainPrice / iQty) : 0;
                if (interSuggestedBadge) {
                    interSuggestedBadge.textContent = `مقترح: ${suggestedInter.toFixed(2)}`;
                }
                if (!interPriceInput.dataset.manualEdited || autoOverride) {
                    interPriceInput.value = suggestedInter > 0 ? suggestedInter.toFixed(2) : '0.00';
                }
                currentInterPrice = parseFloat(interPriceInput.value) || suggestedInter;
            }

            if (smallestQtyInput && smallestPriceInput) {
                const sQty = parseInt(smallestQtyInput.value) || 1;
                let suggestedSmall = 0;
                if (config.hasIntermediate) {
                    suggestedSmall = sQty > 0 ? (currentInterPrice / sQty) : 0;
                } else {
                    suggestedSmall = sQty > 0 ? (mainPrice / sQty) : 0;
                }

                if (smallestSuggestedBadge) {
                    smallestSuggestedBadge.textContent = `مقترح: ${suggestedSmall.toFixed(2)}`;
                }
                if (!smallestPriceInput.dataset.manualEdited || autoOverride) {
                    smallestPriceInput.value = suggestedSmall > 0 ? suggestedSmall.toFixed(2) : '0.00';
                }
            }
        }

        function updateLivePreview() {
            const canSplit = canSplitProductSwitch.checked;
            const mainName = (mainPackageNameInput ? mainPackageNameInput.value.trim() : '') || 'علبة / Box';
            const mainPrice = parseFloat(mainSellingPriceInput.value) || 0;

            nonSplittableUnitBadge.textContent = mainName;
            nonSplittablePriceBadge.textContent = `${mainPrice.toFixed(2)} ج.م`;

            if (!canSplit) {
                packagingFlowVisual.innerHTML = `
                    <div class="badge bg-teal text-white shadow-xs py-2 px-3 text-start">
                        <div class="fw-bold">${mainName}</div>
                        <div class="text-white-50" style="font-size: 0.72rem;">${mainPrice.toFixed(2)} ج.م (العبوة الكاملة فقط)</div>
                    </div>
                `;
                packagingEquationText.innerHTML = `معادلة البيع: <strong class="text-teal">يباع هذا الصنف بالعبوة الكاملة فقط (${mainName})</strong>`;
                return;
            }

            const config = FORM_PRESETS[currentPreset] || FORM_PRESETS.tablets;
            const interQtyInput = document.getElementById('interQtyInput');
            const interPriceInput = document.getElementById('interPriceInput');
            const interAllowSale = document.getElementById('interAllowSale');

            const smallestQtyInput = document.getElementById('smallestQtyInput');
            const smallestPriceInput = document.getElementById('smallestPriceInput');
            const smallestAllowSale = document.getElementById('smallestAllowSale');

            let visualHtml = '';
            let eqParts = [`1 ${mainName}`];

            visualHtml += `
                <div class="badge bg-white text-dark border shadow-xs py-2 px-3 text-start">
                    <div class="fw-bold">${mainName}</div>
                    <div class="text-teal fw-semibold">${mainPrice.toFixed(2)} ج.م</div>
                    <div class="text-muted" style="font-size: 0.72rem;">العبوة الكبرى</div>
                </div>
            `;

            let interQty = 1;
            let interPrice = 0;
            if (config.hasIntermediate && interQtyInput) {
                interQty = parseInt(interQtyInput.value) || 1;
                interPrice = parseFloat(interPriceInput?.value || 0) || 0;
                const saleAllowed = interAllowSale ? interAllowSale.checked : true;

                eqParts.push(`${interQty} ${config.intermediateName}`);

                visualHtml += `
                    <div class="text-muted d-flex align-items-center">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </div>
                    <div class="badge bg-white text-dark border shadow-xs py-2 px-3 text-start">
                        <div class="fw-bold">${config.intermediateName}</div>
                        <div class="text-teal fw-semibold">${interPrice.toFixed(2)} ج.م</div>
                        <div class="${saleAllowed ? 'text-success' : 'text-danger'}" style="font-size: 0.72rem;">
                            ${saleAllowed ? 'متاح للبيع بالكاشير' : 'شراء فقط'}
                        </div>
                    </div>
                `;
            }

            if (config.hasSmallest && smallestQtyInput) {
                const sQty = parseInt(smallestQtyInput.value) || 1;
                const sPrice = parseFloat(smallestPriceInput?.value || 0) || 0;
                const sAllowSale = smallestAllowSale ? smallestAllowSale.checked : true;
                const totalSmallestInBox = config.hasIntermediate ? (interQty * sQty) : sQty;

                eqParts.push(`${totalSmallestInBox} ${config.smallestName}`);

                visualHtml += `
                    <div class="text-muted d-flex align-items-center">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </div>
                    <div class="badge bg-teal text-white shadow-xs py-2 px-3 text-start">
                        <div class="fw-bold">${config.smallestName}</div>
                        <div class="text-white fw-semibold">${sPrice.toFixed(2)} ج.م</div>
                        <div class="text-white-50" style="font-size: 0.72rem;">
                            الوحدة الأساسية للمخزون ${sAllowSale ? '(متاحة للبيع)' : ''}
                        </div>
                    </div>
                `;
            }

            customUnits.forEach(u => {
                visualHtml += `
                    <div class="text-muted d-flex align-items-center">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </div>
                    <div class="badge bg-white text-dark border shadow-xs py-2 px-3 text-start">
                        <div class="fw-bold">${u.name}</div>
                        <div class="text-teal fw-semibold">${(parseFloat(u.price) || 0).toFixed(2)} ج.م</div>
                        <div class="text-muted" style="font-size: 0.72rem;">مخصصة (${u.count} بالعبوة)</div>
                    </div>
                `;
            });

            packagingFlowVisual.innerHTML = visualHtml;
            packagingEquationText.innerHTML = `معادلة التجزئة والتعبئة المعتمدة: <strong class="text-teal">${eqParts.join(' = ')}</strong>`;
        }

        // Custom Units Handlers
        addCustomUnitBtn.addEventListener('click', () => {
            const id = 'custom_' + Date.now();
            const mainPrice = parseFloat(mainSellingPriceInput.value) || 0;
            const newUnit = {
                id: id,
                name: 'وحدة تجزئة مخصصة',
                count: 2,
                price: (mainPrice / 2).toFixed(2),
                allowSale: true,
                barcode: ''
            };
            customUnits.push(newUnit);
            renderCustomUnitsList();
            updateLivePreview();
        });

        function renderCustomUnitsList() {
            if (customUnits.length === 0) {
                customUnitsList.innerHTML = '';
                return;
            }

            let html = '';
            customUnits.forEach(u => {
                html += `
                    <div class="card border rounded-3 p-3 bg-light shadow-xs" data-unit-id="${u.id}">
                        <div class="row g-2 align-items-center">
                            <div class="col-12 col-md-3">
                                <label class="form-label small fw-semibold mb-1">اسم الوحدة</label>
                                <input type="text" class="form-control form-control-sm cu-name" value="${u.name}" required />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small fw-semibold mb-1">العدد بالعلبة</label>
                                <input type="number" class="form-control form-control-sm text-center cu-count" value="${u.count}" min="1" step="1" required />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold mb-1">السعر (ج.م)</label>
                                <input type="number" class="form-control form-control-sm text-center cu-price" value="${u.price}" step="0.01" min="0" />
                            </div>
                            <div class="col-8 col-md-3">
                                <label class="form-label small fw-semibold mb-1">الباركود (اختياري)</label>
                                <input type="text" class="form-control form-control-sm cu-barcode" value="${u.barcode || ''}" />
                            </div>
                            <div class="col-4 col-md-1 text-center">
                                <label class="form-label small fw-semibold mb-1 d-block">حذف</label>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0 cu-remove-btn" title="حذف">&times;</button>
                            </div>
                        </div>
                    </div>
                `;
            });

            customUnitsList.innerHTML = html;

            customUnitsList.querySelectorAll('.cu-name').forEach((inp, idx) => {
                inp.addEventListener('input', function() {
                    customUnits[idx].name = this.value.trim() || 'وحدة';
                    updateLivePreview();
                });
            });

            customUnitsList.querySelectorAll('.cu-count').forEach((inp, idx) => {
                inp.addEventListener('input', function() {
                    customUnits[idx].count = parseInt(this.value) || 1;
                    updateLivePreview();
                });
            });

            customUnitsList.querySelectorAll('.cu-price').forEach((inp, idx) => {
                inp.addEventListener('input', function() {
                    customUnits[idx].price = parseFloat(this.value) || 0;
                    updateLivePreview();
                });
            });

            customUnitsList.querySelectorAll('.cu-barcode').forEach((inp, idx) => {
                inp.addEventListener('input', function() {
                    customUnits[idx].barcode = this.value.trim();
                });
            });

            customUnitsList.querySelectorAll('.cu-remove-btn').forEach((btn, idx) => {
                btn.addEventListener('click', function() {
                    customUnits.splice(idx, 1);
                    renderCustomUnitsList();
                    updateLivePreview();
                });
            });
        }

        canSplitProductSwitch.addEventListener('change', function() {
            if (this.checked) {
                nonSplittableContainer.classList.add('d-none');
                splittableContainer.classList.remove('d-none');
                sellFullPackageOnlyHidden.value = "false";
            } else {
                nonSplittableContainer.classList.remove('d-none');
                splittableContainer.classList.add('d-none');
                sellFullPackageOnlyHidden.value = "true";
            }
            updateLivePreview();
        });

        mainSellingPriceInput.addEventListener('input', function() {
            const price = parseFloat(this.value) || 0;
            mainPackagePriceDisplay.value = price.toFixed(2);
            nonSplittablePriceBadge.textContent = `${price.toFixed(2)} ج.م`;
            updateSuggestedPrices(false);
            updateLivePreview();
        });

        mainPackageNameInput.addEventListener('input', function() {
            this.dataset.userEdited = "true";
            nonSplittableUnitBadge.textContent = this.value.trim() || 'علبة / Box';
            updateLivePreview();
        });

        document.querySelectorAll('.dosage-form-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.dosage-form-btn').forEach(b => {
                    b.classList.remove('btn-teal', 'active');
                    b.classList.add('btn-outline-secondary');
                });
                this.classList.remove('btn-outline-secondary');
                this.classList.add('btn-teal', 'active');

                const formName = this.getAttribute('data-form');
                const presetKey = this.getAttribute('data-preset');
                dosageFormHiddenInput.value = formName;

                const customDiv = document.getElementById('customDosageFormDiv');
                if (presetKey === 'custom') {
                    customDiv.classList.remove('d-none');
                    document.getElementById('customDosageFormInput').focus();
                } else {
                    customDiv.classList.add('d-none');
                    renderGuidedCards(presetKey);
                }
            });
        });

        document.getElementById('applyCustomDosageFormBtn').addEventListener('click', () => {
            const customVal = document.getElementById('customDosageFormInput').value.trim();
            if (customVal) {
                dosageFormHiddenInput.value = customVal;
                packagingPresetBadge.textContent = customVal;
                renderGuidedCards('custom');
            }
        });

        // Quick Category Add
        document.getElementById('saveQuickCategoryBtn').addEventListener('click', async function () {
            const nameInput = document.getElementById('quickCategoryNameInput');
            const descInput = document.getElementById('quickCategoryDescInput');
            const errDiv = document.getElementById('quickCategoryError');
            const name = nameInput.value.trim();

            if (!name) {
                errDiv.textContent = 'يرجى إدخال اسم الفئة';
                errDiv.classList.remove('d-none');
                return;
            }

            errDiv.classList.add('d-none');
            this.disabled = true;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const res = await fetch('@Url.Action("QuickCreate", "Categories")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ name: name, description: descInput.value.trim() })
                });

                const data = await res.json();
                if (data.success) {
                    const select = document.getElementById('productCategorySelect');
                    let exists = false;
                    for (let opt of select.options) {
                        if (opt.value == data.id) {
                            opt.selected = true;
                            exists = true;
                            break;
                        }
                    }
                    if (!exists) {
                        const newOpt = new Option(data.name, data.id, true, true);
                        select.add(newOpt);
                    }

                    nameInput.value = '';
                    descInput.value = '';
                    bootstrap.Modal.getInstance(document.getElementById('quickCategoryModal')).hide();
                } else {
                    errDiv.textContent = data.message || 'حدث خطأ أثناء حفظ الفئة';
                    errDiv.classList.remove('d-none');
                }
            } catch (err) {
                errDiv.textContent = 'تعذر الاتصال بالخادم';
                errDiv.classList.remove('d-none');
            } finally {
                this.disabled = false;
            }
        });

        // Form Submit
        form.addEventListener('submit', () => {
            const canSplit = canSplitProductSwitch.checked;
            const mainName = (mainPackageNameInput ? mainPackageNameInput.value.trim() : '') || 'علبة / Box';
            const mainPrice = parseFloat(mainSellingPriceInput.value) || 0;
            const mainBarcode = (mainBarcodeInput ? mainBarcodeInput.value.trim() : '') || null;

            if (!canSplit) {
                sellFullPackageOnlyHidden.value = "true";
                baseUnitNameHidden.value = mainName;
                unitsJsonHidden.value = "[]";
                return;
            }

            sellFullPackageOnlyHidden.value = "false";
            const config = FORM_PRESETS[currentPreset] || FORM_PRESETS.tablets;
            const interQtyInput = document.getElementById('interQtyInput');
            const interPriceInput = document.getElementById('interPriceInput');
            const interBarcodeInput = document.getElementById('interBarcodeInput');
            const interAllowSale = document.getElementById('interAllowSale');

            const smallestQtyInput = document.getElementById('smallestQtyInput');
            const smallestPriceInput = document.getElementById('smallestPriceInput');
            const smallestBarcodeInput = document.getElementById('smallestBarcodeInput');
            const smallestAllowSale = document.getElementById('smallestAllowSale');

            const unitsList = [];

            if (config.hasIntermediate) {
                const interQty = parseInt(interQtyInput?.value || 3) || 1;
                const interPrice = parseFloat(interPriceInput?.value || 0) || (mainPrice / interQty);
                const interBarcode = (interBarcodeInput ? interBarcodeInput.value.trim() : '') || null;
                const allowSaleInter = interAllowSale ? interAllowSale.checked : true;

                const sQty = parseInt(smallestQtyInput?.value || 10) || 1;
                const sPrice = parseFloat(smallestPriceInput?.value || 0) || (interPrice / sQty);
                const sBarcode = (smallestBarcodeInput ? smallestBarcodeInput.value.trim() : '') || null;
                const allowSaleSmall = smallestAllowSale ? smallestAllowSale.checked : true;

                baseUnitNameHidden.value = config.smallestName;

                unitsList.push({
                    unitName: config.smallestName,
                    conversionFactor: 1,
                    sellingPrice: sPrice,
                    barcode: sBarcode,
                    isBaseUnit: true,
                    allowSale: allowSaleSmall,
                    allowPurchase: true
                });

                unitsList.push({
                    unitName: config.intermediateName,
                    conversionFactor: sQty,
                    containsQuantity: sQty,
                    containsUnitName: config.smallestName,
                    sellingPrice: interPrice,
                    barcode: interBarcode,
                    isBaseUnit: false,
                    allowSale: allowSaleInter,
                    allowPurchase: true
                });

                const totalInBox = interQty * sQty;
                unitsList.push({
                    unitName: mainName,
                    conversionFactor: totalInBox,
                    containsQuantity: interQty,
                    containsUnitName: config.intermediateName,
                    sellingPrice: mainPrice,
                    barcode: mainBarcode,
                    isBaseUnit: false,
                    allowSale: true,
                    allowPurchase: true
                });
            } else if (config.hasSmallest) {
                const sQty = parseInt(smallestQtyInput?.value || 1) || 1;
                const sPrice = parseFloat(smallestPriceInput?.value || 0) || (sQty > 0 ? (mainPrice / sQty) : mainPrice);
                const sBarcode = (smallestBarcodeInput ? smallestBarcodeInput.value.trim() : '') || null;
                const allowSaleSmall = smallestAllowSale ? smallestAllowSale.checked : true;

                baseUnitNameHidden.value = config.smallestName;

                unitsList.push({
                    unitName: config.smallestName,
                    conversionFactor: 1,
                    sellingPrice: sPrice,
                    barcode: sBarcode,
                    isBaseUnit: true,
                    allowSale: allowSaleSmall,
                    allowPurchase: true
                });

                unitsList.push({
                    unitName: mainName,
                    conversionFactor: sQty,
                    containsQuantity: sQty,
                    containsUnitName: config.smallestName,
                    sellingPrice: mainPrice,
                    barcode: mainBarcode,
                    isBaseUnit: false,
                    allowSale: true,
                    allowPurchase: true
                });
            } else {
                baseUnitNameHidden.value = mainName;
                unitsList.push({
                    unitName: mainName,
                    conversionFactor: 1,
                    sellingPrice: mainPrice,
                    barcode: mainBarcode,
                    isBaseUnit: true,
                    allowSale: true,
                    allowPurchase: true
                });
            }

            customUnits.forEach(u => {
                if (!u.name || !u.name.trim()) return;
                const uCount = parseInt(u.count) || 1;
                const uPrice = parseFloat(u.price) || 0;
                unitsList.push({
                    unitName: u.name.trim(),
                    conversionFactor: uCount,
                    sellingPrice: uPrice,
                    barcode: u.barcode ? u.barcode.trim() : null,
                    isBaseUnit: false,
                    allowSale: true,
                    allowPurchase: true
                });
            });

            unitsJsonHidden.value = JSON.stringify(unitsList);
        });

        // Initialize from existing product data in Edit mode
        document.addEventListener('DOMContentLoaded', () => {
            const currentDosage = dosageFormHiddenInput.value;
            let detectedPreset = 'tablets';

            if (currentDosage) {
                document.querySelectorAll('.dosage-form-btn').forEach(btn => {
                    const btnForm = btn.getAttribute('data-form');
                    if (btnForm === currentDosage || currentDosage.includes(btnForm.split('/')[0].trim())) {
                        btn.classList.remove('btn-outline-secondary');
                        btn.classList.add('btn-teal', 'active');
                        detectedPreset = btn.getAttribute('data-preset') || 'tablets';
                    }
                });
            }

            // Extract initial units data if available
            const initialUnitsJson = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UnitsJson));
            let initialData = null;

            if (initialUnitsJson) {
                try {
                    const parsed = JSON.parse(initialUnitsJson);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        // Find top package, intermediate, smallest
                        const sorted = parsed.slice().sort((a, b) => (b.ConversionFactor || b.conversionFactor || 1) - (a.ConversionFactor || a.conversionFactor || 1));
                        const topUnit = sorted[0];
                        const smallestUnit = sorted[sorted.length - 1];

                        initialData = {
                            mainPackageName: topUnit?.UnitName || topUnit?.unitName || 'علبة / Box'
                        };

                        if (sorted.length >= 3) {
                            const interUnit = sorted[1];
                            initialData.interQty = topUnit.ContainsQuantity || topUnit.containsQuantity || (topUnit.ConversionFactor / interUnit.ConversionFactor) || 3;
                            initialData.interPrice = interUnit.SellingPrice || interUnit.sellingPrice;
                            initialData.interAllowSale = interUnit.AllowSale !== undefined ? interUnit.AllowSale : (interUnit.allowSale !== undefined ? interUnit.allowSale : true);
                            initialData.interBarcode = interUnit.Barcode || interUnit.barcode || '';

                            initialData.smallestQty = interUnit.ContainsQuantity || interUnit.containsQuantity || interUnit.ConversionFactor || 10;
                            initialData.smallestPrice = smallestUnit.SellingPrice || smallestUnit.sellingPrice;
                            initialData.smallestAllowSale = smallestUnit.AllowSale !== undefined ? smallestUnit.AllowSale : (smallestUnit.allowSale !== undefined ? smallestUnit.allowSale : true);
                            initialData.smallestBarcode = smallestUnit.Barcode || smallestUnit.barcode || '';
                        } else if (sorted.length === 2) {
                            initialData.smallestQty = topUnit.ContainsQuantity || topUnit.containsQuantity || topUnit.ConversionFactor || 1;
                            initialData.smallestPrice = smallestUnit.SellingPrice || smallestUnit.sellingPrice;
                            initialData.smallestAllowSale = smallestUnit.AllowSale !== undefined ? smallestUnit.AllowSale : (smallestUnit.allowSale !== undefined ? smallestUnit.allowSale : true);
                            initialData.smallestBarcode = smallestUnit.Barcode || smallestUnit.barcode || '';
                        }
                    }
                } catch (e) {
                    console.error('Error parsing initial units json', e);
                }
            }

            renderGuidedCards(detectedPreset, initialData);

            // Handle SellFullPackageOnly switch initial state
            const isFullPackageOnly = @(Model.SellFullPackageOnly ? "true" : "false");
            if (isFullPackageOnly) {
                canSplitProductSwitch.checked = false;
                nonSplittableContainer.classList.remove('d-none');
                splittableContainer.classList.add('d-none');
                sellFullPackageOnlyHidden.value = "true";
            } else {
                canSplitProductSwitch.checked = true;
                nonSplittableContainer.classList.add('d-none');
                splittableContainer.classList.remove('d-none');
                sellFullPackageOnlyHidden.value = "false";
            }

            updateLivePreview();
        });
    </script>
}
