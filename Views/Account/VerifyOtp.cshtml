@model PharmacySystem.Models.ViewModels.Auth.VerifyOtpViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    Layout = null;
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Loc["VerifyOtpTitle"] - @Loc["AppTitle"]</title>

    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/pharmacy-theme.css" asp-append-version="true" />
    <style>
        .otp-input {
            letter-spacing: 12px;
            font-size: 28px;
            font-weight: 700;
            text-align: center;
            font-family: 'Consolas', 'Courier New', monospace;
            color: #0d7377;
        }
    </style>
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-4">
    <div class="container" style="max-width: 460px;">
        <div class="d-flex justify-content-end mb-3">
            <partial name="_LanguageSwitcher" />
        </div>

        <div class="card border-0 shadow-lg ph-card overflow-hidden">
            <div class="card-header bg-teal text-white text-center p-4 border-0">
                <div class="mb-2">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <h4 class="fw-bold mb-1">@Loc["VerifyOtpTitle"]</h4>
                <p class="text-white-50 small mb-0">@Loc["OtpSentNotice"]</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <form asp-controller="Account" asp-action="VerifyOtp" method="post" id="verifyOtpForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3" role="alert"></div>

                    <div class="mb-2 text-center text-muted small">
                        @Loc["TargetEmail"] <br />
                        <strong class="text-dark">@Model.Email</strong>
                    </div>

                    <div class="mb-4 text-center">
                        <label asp-for="OtpCode" class="form-label fw-semibold mb-2">@Loc["EnterSixDigitOtp"]</label>
                        <input asp-for="OtpCode" 
                               type="text" 
                               class="form-control form-control-lg otp-input" 
                               maxlength="6" 
                               placeholder="------" 
                               inputmode="numeric" 
                               pattern="[0-9]*" 
                               autocomplete="one-time-code" 
                               autofocus />
                        <span asp-validation-for="OtpCode" class="field-validation-error text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="alert alert-warning small text-start py-2 px-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>&#9201; @Loc["CodeValidity"] <strong id="countdownTimer">@Model.RemainingSeconds</strong> @Loc["Seconds"]</span>
                            <span class="badge bg-secondary" id="attemptsNotice">@Loc["MaxAttemptsNotice"]</span>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="btn btn-teal w-100 py-2 fw-semibold shadow-sm mb-3">
                        @Loc["ConfirmOtpAndProceed"]
                    </button>
                </form>

                <div class="border-top pt-3 mt-2 text-center">
                    <form asp-controller="Account" asp-action="ResendOtp" method="post" id="resendForm" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@Model.Email" />
                        <button type="submit" id="resendBtn" class="btn btn-outline-secondary btn-sm" disabled>
                            @Loc["ResendNewOtp"] (<span id="resendTimer">@Model.RemainingSeconds</span>)
                        </button>
                    </form>
                    <div class="mt-3">
                        <a asp-action="Login" class="text-decoration-none small text-secondary">
                            &larr; @Loc["BackToLogin"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pharmacy.js" asp-append-version="true"></script>
    <script>
        (function () {
            let seconds = @Model.RemainingSeconds;
            const timerEl = document.getElementById('countdownTimer');
            const resendTimerEl = document.getElementById('resendTimer');
            const resendBtn = document.getElementById('resendBtn');
            const submitBtn = document.getElementById('submitBtn');
            const otpInput = document.getElementById('OtpCode');

            const textExpired = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc["CodeExpired"].Value));
            const textAvailableNow = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc["AvailableNow"].Value));
            const textExpiredAction = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc["CodeExpiredRequestNew"].Value));

            const interval = setInterval(function () {
                seconds--;
                if (seconds <= 0) {
                    clearInterval(interval);
                    if (timerEl) timerEl.textContent = '0 (' + textExpired + ')';
                    if (resendTimerEl) resendTimerEl.textContent = textAvailableNow;
                    if (resendBtn) resendBtn.disabled = false;
                    if (submitBtn) {
                        submitBtn.classList.replace('btn-teal', 'btn-secondary');
                        submitBtn.disabled = true;
                        submitBtn.textContent = textExpiredAction;
                    }
                    if (otpInput) otpInput.disabled = true;
                } else {
                    if (timerEl) timerEl.textContent = seconds;
                    if (resendTimerEl) resendTimerEl.textContent = seconds + 's';
                }
            }, 1000);
        })();
    </script>
</body>
</html>
