@model PharmacySystem.Models.Common.PaginatedList<PharmacySystem.Models.ViewModels.Products.ProductListItemViewModel>
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["Nav_Products"];
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1">@Loc["Nav_Products"]</h4>
            <p class="text-muted small mb-0">@Loc["ProductsSubtitle"]</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-teal d-inline-flex align-items-center gap-2 shadow-sm">
                <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>@Loc["AddProduct"]</span>
            </a>
        </div>
    </div>

    @* Search & Filter Card *@
    <div class="card border-0 shadow-sm ph-card mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        </span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="@Loc["SearchPlaceholderProducts"]" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="categoryId" class="form-select" asp-items="@ViewBag.Categories">
                        <option value="">-- @Loc["AllCategories"] --</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <div class="form-check form-switch pt-2">
                        <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockSwitch" @(ViewBag.LowStockOnly == true ? "checked" : "") />
                        <label class="form-check-label small" for="lowStockSwitch">@Loc["LowStockOnly"]</label>
                    </div>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-teal w-100">@Loc["Filter"]</button>
                    @if (!string.IsNullOrEmpty(ViewBag.Search) || ViewBag.CategoryId != null || ViewBag.LowStockOnly == true)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">@Loc["Clear"]</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @* Products Table Card *@
    <div class="card border-0 shadow-sm ph-card overflow-hidden">
        @if (!Model.Items.Any())
        {
            <div class="p-5 text-center">
                <partial name="_EmptyState" model='new PharmacySystem.Models.Common.EmptyStateViewModel { Title = Loc["NoProductsFound"], Message = Loc["NoProductsFoundMessage"], ActionText = Loc["AddProduct"], ActionUrl = Url.Action("Create") }' />
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 ph-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Loc["Name"]</th>
                            <th>@Loc["Barcode"]</th>
                            <th>@Loc["Category"]</th>
                            <th>@Loc["SellingPrice"]</th>
                            <th>@Loc["AvailableStock"]</th>
                            <th>@Loc["Status"]</th>
                            <th class="text-end pe-4">@Loc["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-dark">@product.Name</div>
                                    @if (product.IsLowStock)
                                    {
                                        <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">@Loc["LowStock"]</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.Barcode))
                                    {
                                        <code class="small text-dark bg-light px-2 py-1 rounded">@product.Barcode</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@product.CategoryName</span></td>
                                <td class="fw-semibold">@product.SellingPrice.ToString("C2")</td>
                                <td>
                                    <span class="fw-bold @(product.NonExpiredStock == 0 ? "text-danger" : product.IsLowStock ? "text-warning" : "text-success")">
                                        @product.NonExpiredStock
                                    </span>
                                    @if (product.TotalStock > product.NonExpiredStock)
                                    {
                                        <span class="small text-muted" title="@Loc["ExpiredStockExcluded"]">(@Loc["Total"]: @product.TotalStock)</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">
                                        @(product.IsActive ? Loc["Active"] : Loc["Inactive"])
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-secondary" title="@Loc["Details"]">
                                            <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-primary" title="@Loc["Edit"]">
                                            <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </a>
                                        <a asp-controller="Purchases" asp-action="Create" asp-route-productId="@product.Id" class="btn btn-sm btn-outline-success" title="@Loc["AddStock"]">
                                            <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                        </a>
                                        <form asp-controller="Products" asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('@Loc["ConfirmDelete"]');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="@Loc["Delete"]">
                                                <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top p-3">
                <partial name="_Pagination" model="Model.ToPaginationViewModel()" />
            </div>
        }
    </div>
</div>
