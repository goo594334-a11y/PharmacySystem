@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@using PharmacySystem.Services.Auth
@inject IStringLocalizer<SharedResource> Loc
@inject ICurrentUserService CurrentUser

<header class="ph-topbar border-bottom px-3 py-2 d-flex align-items-center justify-content-between sticky-top shadow-sm">
    @* Left: Sidebar toggle & quick search / breadcrumb context *@
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-sm btn-light border ph-sidebar-toggle" id="phSidebarToggle" type="button" aria-label="Toggle navigation">
            <svg class="ph-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>

        <div class="d-none d-md-flex align-items-center gap-2">
            <a asp-controller="Sales" asp-action="New" class="btn btn-sm btn-teal d-flex align-items-center gap-2 shadow-sm">
                <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>@Loc["NewSale"]</span>
            </a>
        </div>
    </div>

    @* Right: Theme switcher, language switcher, notifications, user profile *@
    <div class="d-flex align-items-center gap-2 gap-md-3">
        @* Theme Switcher (Light / Dark) *@
        <button type="button" class="btn btn-sm btn-light border p-1 rounded-circle ph-theme-toggle" id="phThemeToggle" title="@Loc["ToggleTheme"]" aria-label="@Loc["ToggleTheme"]">
            <svg class="ph-icon d-none" id="phThemeIconSun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="ph-icon" id="phThemeIconMoon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
        </button>

        @* Language Switcher *@
        <partial name="_LanguageSwitcher" />

        @* Notification Bell Component *@
        @await Component.InvokeAsync("NotificationBell")

        @* User Profile Dropdown *@
        @if (CurrentUser.IsAuthenticated)
        {
            <div class="dropdown ph-user-dropdown">
                <button class="btn btn-sm btn-light border d-flex align-items-center gap-2 py-1 px-2 rounded-pill" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="ph-avatar-sm bg-teal text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.75rem;">
                        @(CurrentUser.DisplayName?.Substring(0, Math.Min(1, CurrentUser.DisplayName.Length)).ToUpper() ?? "U")
                    </div>
                    <span class="d-none d-sm-inline small fw-semibold text-dark">@CurrentUser.DisplayName</span>
                    <span class="badge @(CurrentUser.IsAdmin ? "bg-primary" : "bg-success") rounded-pill d-none d-md-inline" style="font-size: 0.65rem;">
                        @(CurrentUser.IsAdmin ? Loc["Role_Admin"] : Loc["Role_Pharmacist"])
                    </span>
                    <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenuDropdown">
                    <li class="px-3 py-2 border-bottom">
                        <div class="fw-bold small text-dark">@CurrentUser.DisplayName</div>
                        <div class="text-muted small" style="font-size: 0.75rem;">@CurrentUser.Email</div>
                    </li>
                    <li>
                        <a asp-controller="Account" asp-action="ChangePassword" class="dropdown-item d-flex align-items-center gap-2 py-2 text-secondary">
                            <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            <span>@Loc["ChangePassword"]</span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 py-2">
                                <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                <span>@Loc["Logout"]</span>
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary px-3">
                @Loc["Login"]
            </a>
        }
    </div>
</header>
