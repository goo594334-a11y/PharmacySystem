@model PharmacySystem.Models.Common.PaginatedList<PharmacySystem.Models.Entities.AuditLog>
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["Nav_AuditLogs"];
    var actions = ViewBag.ActionsList as List<string> ?? new();
}

<div class="container-fluid px-0">
    <div class="mb-4">
        <h4 class="fw-bold mb-1">@Loc["Nav_AuditLogs"]</h4>
        <p class="text-muted small mb-0">@Loc["AuditLogsSubtitle"]</p>
    </div>

    @* Filters *@
    <div class="card border-0 shadow-sm ph-card mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="@Loc["SearchPlaceholderAudit"]" />
                </div>
                <div class="col-6 col-md-3">
                    <select name="actionFilter" class="form-select">
                        <option value="">-- @Loc["AllActions"] --</option>
                        @foreach (var act in actions)
                        {
                            <option value="@act" selected="@(ViewBag.ActionFilter == act ? "selected" : null)">@act</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
                </div>
                <div class="col-12 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-teal w-100">@Loc["Filter"]</button>
                    @if (!string.IsNullOrEmpty(ViewBag.Search) || !string.IsNullOrEmpty(ViewBag.ActionFilter) || ViewBag.FromDate != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">@Loc["Clear"]</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @* Audit Logs Table *@
    <div class="card border-0 shadow-sm ph-card overflow-hidden">
        @if (!Model.Items.Any())
        {
            <div class="p-5 text-center">
                <partial name="_EmptyState" model='new PharmacySystem.Models.Common.EmptyStateViewModel { Title = Loc["NoAuditEventsFound"], Message = Loc["NoAuditEventsRecorded"] }' />
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 ph-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Loc["Timestamp"]</th>
                            <th>@Loc["User"]</th>
                            <th>@Loc["Action"]</th>
                            <th>@Loc["Entity"]</th>
                            <th class="text-end pe-4">@Loc["EntityId"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") UTC</td>
                                <td>
                                    @if (log.User != null)
                                    {
                                        <span class="fw-semibold text-dark">@log.User.FullName</span>
                                        <span class="text-muted small"> (@log.User.Email)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">System / Anonymous</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(log.Action.Contains("Delete") ? "bg-danger" : log.Action.Contains("Create") ? "bg-success" : log.Action.Contains("Login") ? "bg-primary" : "bg-teal")">
                                        @log.Action
                                    </span>
                                </td>
                                <td><code>@log.EntityName</code></td>
                                <td class="text-end pe-4">
                                    <span class="badge bg-light text-dark border">@log.EntityId</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top p-3">
                <partial name="_Pagination" model="Model.ToPaginationViewModel()" />
            </div>
        }
    </div>
</div>
