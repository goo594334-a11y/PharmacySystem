@model List<PharmacySystem.Controllers.PharmacyApprovalItemViewModel>
@using Microsoft.Extensions.Localization
@using PharmacySystem.Models.Entities
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["DeveloperAdminDashboard"];
    var currentStatus = ViewBag.CurrentStatus as string;
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <svg class="ph-icon text-teal" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>@Loc["DeveloperAdminDashboard"]</span>
            </h4>
            <p class="text-muted small mb-0">@Loc["DeveloperAdminSubtitle"]</p>
        </div>
    </div>

    @* Stat Overview Cards *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm ph-card p-3">
                <div class="text-muted small">@Loc["PendingApprovals"]</div>
                <div class="fs-4 fw-bold @(ViewBag.PendingCount > 0 ? "text-warning" : "text-muted") mt-1">
                    @ViewBag.PendingCount
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm ph-card p-3">
                <div class="text-muted small">@Loc["ActivePharmacies"]</div>
                <div class="fs-4 fw-bold text-success mt-1">@ViewBag.ActiveCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm ph-card p-3">
                <div class="text-muted small">@Loc["SuspendedPharmacies"]</div>
                <div class="fs-4 fw-bold text-danger mt-1">@ViewBag.SuspendedCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm ph-card p-3">
                <div class="text-muted small">@Loc["RejectedPharmacies"]</div>
                <div class="fs-4 fw-bold text-secondary mt-1">@ViewBag.RejectedCount</div>
            </div>
        </div>
    </div>

    @* Table Card *@
    <div class="card border-0 shadow-sm ph-card overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <ul class="nav nav-pills card-header-pills gap-1">
                <li class="nav-item">
                    <a asp-action="Index" class="nav-link py-1 px-3 small @(string.IsNullOrEmpty(currentStatus) ? "active bg-teal" : "")">
                        @Loc["All"] (@Model.Count)
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" asp-route-status="PendingApproval" class="nav-link py-1 px-3 small @(currentStatus == "PendingApproval" ? "active bg-teal" : "")">
                        @Loc["PendingApproval"] (@ViewBag.PendingCount)
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" asp-route-status="Active" class="nav-link py-1 px-3 small @(currentStatus == "Active" ? "active bg-teal" : "")">
                        @Loc["Active"] (@ViewBag.ActiveCount)
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" asp-route-status="Suspended" class="nav-link py-1 px-3 small @(currentStatus == "Suspended" ? "active bg-teal" : "")">
                        @Loc["Suspended"] (@ViewBag.SuspendedCount)
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" asp-route-status="Rejected" class="nav-link py-1 px-3 small @(currentStatus == "Rejected" ? "active bg-teal" : "")">
                        @Loc["Rejected"] (@ViewBag.RejectedCount)
                    </a>
                </li>
            </ul>

            <form method="get" class="d-flex align-items-center gap-2">
                <input type="hidden" name="status" value="@currentStatus" />
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="@Loc["SearchPharmaciesPlaceholder"]" />
                <button type="submit" class="btn btn-sm btn-outline-teal px-3">@Loc["Search"]</button>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 ph-table">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">@Loc["Pharmacy"]</th>
                        <th>@Loc["ResponsiblePerson"]</th>
                        <th>@Loc["ContactDetails"]</th>
                        <th>@Loc["RegistrationDate"]</th>
                        <th>@Loc["Status"]</th>
                        <th class="text-end pe-4">@Loc["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted small">
                                @Loc["NoPharmaciesFound"]
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <div class="text-muted small">@(item.Code ?? $"ID: #{item.Id}")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(item.AdminFullName ?? "-")</div>
                                    <div class="text-muted small">@(item.AdminEmail ?? "-")</div>
                                </td>
                                <td>
                                    <div>@(item.Phone ?? "-")</div>
                                    <div class="text-muted small text-truncate" style="max-width: 180px;">@(item.Address ?? "-")</div>
                                </td>
                                <td>
                                    <span class="small text-muted">@item.CreatedAt.ToLocalTime().ToString("g")</span>
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case PharmacyStatus.PendingApproval:
                                            <span class="badge bg-warning text-dark">@Loc["PendingApproval"]</span>
                                            break;
                                        case PharmacyStatus.Active:
                                            <span class="badge bg-success">@Loc["Active"]</span>
                                            break;
                                        case PharmacyStatus.Suspended:
                                            <span class="badge bg-danger">@Loc["Suspended"]</span>
                                            break;
                                        case PharmacyStatus.Rejected:
                                            <span class="badge bg-secondary">@Loc["Rejected"]</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        @if (item.Status == PharmacyStatus.PendingApproval)
                                        {
                                            <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-teal d-inline-flex align-items-center gap-1" title="@Loc["Approve"]">
                                                    <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                    <span>@Loc["Approve"]</span>
                                                </button>
                                            </form>
                                            <form asp-action="Reject" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" title="@Loc["Reject"]">
                                                    <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                    <span>@Loc["Reject"]</span>
                                                </button>
                                            </form>
                                        }
                                        else if (item.Status == PharmacyStatus.Active)
                                        {
                                            @if (item.Id != 1)
                                            {
                                                <form asp-action="Suspend" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="@Loc["Suspend"]">
                                                        @Loc["Suspend"]
                                                    </button>
                                                </form>
                                            }
                                        }
                                        else if (item.Status == PharmacyStatus.Suspended || item.Status == PharmacyStatus.Rejected)
                                        {
                                            <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-teal" title="@Loc["Activate"]">
                                                    @Loc["Activate"]
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
