@model PharmacySystem.Models.Common.PaginatedList<PharmacySystem.Models.ViewModels.Returns.PurchaseReturnListItemViewModel>
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["PurchaseReturns"];
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1">@Loc["PurchaseReturns"]</h4>
            <p class="text-muted small mb-0">@Loc["PurchaseReturnsSubtitle"]</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Sales" class="btn btn-outline-secondary">@Loc["SalesReturns"]</a>
        </div>
    </div>

    @* Search Form *@
    <div class="card border-0 shadow-sm ph-card mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        </span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="@Loc["SearchPlaceholderReturns"]" />
                    </div>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-teal w-100">@Loc["Search"]</button>
                    @if (!string.IsNullOrEmpty(ViewBag.Search))
                    {
                        <a asp-action="Purchases" class="btn btn-outline-secondary">@Loc["Clear"]</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @* Purchase Returns Table *@
    <div class="card border-0 shadow-sm ph-card overflow-hidden">
        @if (!Model.Items.Any())
        {
            <div class="p-5 text-center">
                <partial name="_EmptyState" model='new PharmacySystem.Models.Common.EmptyStateViewModel { Title = Loc["NoReturnsFound"], Message = Loc["NoPurchaseReturnsRecorded"], ActionText = Loc["ViewPurchases"], ActionUrl = Url.Action("Index", "Purchases") }' />
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 ph-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Loc["OriginalInvoice"]</th>
                            <th>@Loc["ReturnDate"]</th>
                            <th>@Loc["Items"]</th>
                            <th>@Loc["TotalAmount"]</th>
                            <th>@Loc["Reason"]</th>
                            <th class="text-end pe-4">@Loc["ProcessedBy"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">#@r.PurchaseInvoiceNumber</td>
                                <td>@r.ReturnDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge bg-light text-dark border">@r.ItemsCount @Loc["Items"]</span></td>
                                <td class="fw-bold text-dark">@r.TotalAmount.ToString("C2")</td>
                                <td class="text-muted small">@r.Reason</td>
                                <td class="text-end pe-4 small text-secondary">@r.ProcessedByName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top p-3">
                <partial name="_Pagination" model="Model.ToPaginationViewModel()" />
            </div>
        }
    </div>
</div>
