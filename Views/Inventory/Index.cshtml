@model PharmacySystem.Models.Common.PaginatedList<PharmacySystem.Models.ViewModels.Inventory.InventoryProductListItemViewModel>
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@using PharmacySystem.Models.ViewModels.Inventory
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["Nav_Inventory"];
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1">@Loc["Nav_Inventory"]</h4>
            <p class="text-muted small mb-0">@Loc["InventorySubtitle"]</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Batches" class="btn btn-outline-secondary">@Loc["BatchTracking"]</a>
            <a asp-action="LowStock" class="btn btn-outline-warning">@Loc["LowStockAlerts"]</a>
            <a asp-action="Expiry" class="btn btn-outline-danger">@Loc["ExpiryTracking"]</a>
        </div>
    </div>

    @* Filters *@
    <div class="card border-0 shadow-sm ph-card mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        </span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="@Loc["SearchPlaceholderProducts"]" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="categoryId" class="form-select" asp-items="@ViewBag.Categories">
                        <option value="">-- @Loc["AllCategories"] --</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select name="status" class="form-select">
                        <option value="">-- @Loc["AllStatuses"] --</option>
                        <option value="@ProductInventoryStatus.Normal" selected="@(ViewBag.Status == ProductInventoryStatus.Normal ? "selected" : null)">@Loc["Normal"]</option>
                        <option value="@ProductInventoryStatus.LowStock" selected="@(ViewBag.Status == ProductInventoryStatus.LowStock ? "selected" : null)">@Loc["LowStock"]</option>
                        <option value="@ProductInventoryStatus.OutOfStock" selected="@(ViewBag.Status == ProductInventoryStatus.OutOfStock ? "selected" : null)">@Loc["OutOfStock"]</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-teal w-100">@Loc["Filter"]</button>
                    @if (!string.IsNullOrEmpty(ViewBag.Search) || ViewBag.CategoryId != null || ViewBag.Status != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">@Loc["Clear"]</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @* Inventory Table Card *@
    <div class="card border-0 shadow-sm ph-card overflow-hidden">
        @if (!Model.Items.Any())
        {
            <div class="p-5 text-center">
                <partial name="_EmptyState" model='new PharmacySystem.Models.Common.EmptyStateViewModel { Title = Loc["NoInventoryRecordsFound"], Message = Loc["NoProductsFoundMessage"] }' />
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 ph-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Loc["Product"]</th>
                            <th>@Loc["Category"]</th>
                            <th>@Loc["SellingPrice"]</th>
                            <th>@Loc["AvailableStock"]</th>
                            <th>@Loc["MinimumStockLevel"]</th>
                            <th>@Loc["ExpiredStock"]</th>
                            <th>@Loc["Status"]</th>
                            <th class="text-end pe-4">@Loc["Action"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-dark">@item.ProductName</div>
                                    @if (!string.IsNullOrEmpty(item.Barcode))
                                    {
                                        <code class="small text-muted">@item.Barcode</code>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.CategoryName</span></td>
                                <td class="fw-semibold">@item.SellingPrice.ToString("C2")</td>
                                <td>
                                    <span class="fw-bold @(item.NonExpiredStock == 0 ? "text-danger" : item.Status == ProductInventoryStatus.LowStock ? "text-warning" : "text-success")">
                                        @item.NonExpiredStock
                                    </span>
                                </td>
                                <td>@item.MinimumStockLevel</td>
                                <td>
                                    @if (item.ExpiredStock > 0)
                                    {
                                        <span class="badge bg-danger">@item.ExpiredStock @Loc["ExpiredUnits"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == ProductInventoryStatus.OutOfStock)
                                    {
                                        <span class="badge bg-danger">@Loc["OutOfStock"]</span>
                                    }
                                    else if (item.Status == ProductInventoryStatus.LowStock)
                                    {
                                        <span class="badge bg-warning text-dark">@Loc["LowStock"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@Loc["InStock"]</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-secondary">
                                        @Loc["ViewBatches"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top p-3">
                <partial name="_Pagination" model="Model.ToPaginationViewModel()" />
            </div>
        }
    </div>
</div>
