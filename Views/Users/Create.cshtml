@model PharmacySystem.Models.ViewModels.Users.CreateUserViewModel
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@using PharmacySystem.Enums
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["AddUser"];
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm ph-card">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold">@Loc["AddUser"]</h5>
                    <p class="text-muted small mb-0">@Loc["CreateUserSubtitle"]</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3" role="alert"></div>

                        @* Full Name *@
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label required">@Loc["FullName"]</label>
                            <input asp-for="FullName" class="form-control" autofocus />
                            <span asp-validation-for="FullName" class="field-validation-error"></span>
                        </div>

                        @* Email *@
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label required">@Loc["Email"]</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="user@gmail.com" />
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>

                        @* Role *@
                        <div class="mb-3">
                            <label asp-for="Role" class="form-label required">@Loc["Role"]</label>
                            <select asp-for="Role" class="form-select">
                                <option value="@UserRole.Pharmacist">@Loc["Role_Pharmacist"]</option>
                                <option value="@UserRole.Admin">@Loc["Role_Admin"]</option>
                            </select>
                            <span asp-validation-for="Role" class="field-validation-error"></span>
                        </div>

                        @* Password with Show/Hide Eye Button *@
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label required">@Loc["Password"]</label>
                            <div class="input-group">
                                <input asp-for="Password" type="password" class="form-control border-end-0" id="createUserPasswordInput" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password-btn" data-target="#createUserPasswordInput" aria-label="Toggle Password">
                                    <svg class="ph-icon eye-open" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                    <svg class="ph-icon eye-closed d-none" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="m1 1 22 22"></path><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path></svg>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="field-validation-error"></span>
                        </div>

                        @* Confirm Password with Show/Hide Eye Button *@
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label required">@Loc["ConfirmPassword"]</label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" type="password" class="form-control border-end-0" id="createUserConfirmInput" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password-btn" data-target="#createUserConfirmInput" aria-label="Toggle Password">
                                    <svg class="ph-icon eye-open" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                    <svg class="ph-icon eye-closed d-none" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="m1 1 22 22"></path><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path></svg>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                        </div>

                        @* Status *@
                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="createUserIsActive" checked />
                            <label class="form-check-label" for="createUserIsActive">@Loc["Active"]</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
                            <button type="submit" class="btn btn-teal px-4 fw-semibold">@Loc["Save"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
