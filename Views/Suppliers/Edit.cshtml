@model PharmacySystem.Models.ViewModels.Suppliers.EditSupplierViewModel
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["EditSupplier"];
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm ph-card">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold">@Loc["EditSupplier"]</h5>
                    <p class="text-muted small mb-0">@Loc["EditSupplierSubtitle"]</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label required">@Loc["SupplierName"]</label>
                            <input asp-for="Name" class="form-control" autofocus />
                            <span asp-validation-for="Name" class="field-validation-error"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="Phone" class="form-label">@Loc["Phone"]</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="field-validation-error"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="Email" class="form-label">@Loc["Email"]</label>
                                <input asp-for="Email" class="form-control" type="email" />
                                <span asp-validation-for="Email" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">@Loc["Address"]</label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="field-validation-error"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">@Loc["Notes"]</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="field-validation-error"></span>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="supplierIsActiveSwitch" />
                            <label class="form-check-label" for="supplierIsActiveSwitch">@Loc["Active"]</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
                            <button type="submit" class="btn btn-teal px-4 fw-semibold">@Loc["Save"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
