@model PharmacySystem.Models.ViewModels.Expenses.CreateExpenseViewModel
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@using PharmacySystem.Enums
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["AddExpense"];
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm ph-card">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold">@Loc["AddExpense"]</h5>
                    <p class="text-muted small mb-0">@Loc["CreateExpenseSubtitle"]</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="ExpenseDate" class="form-label required">@Loc["ExpenseDate"]</label>
                            <input asp-for="ExpenseDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" autofocus />
                            <span asp-validation-for="ExpenseDate" class="field-validation-error"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label required">@Loc["Category"]</label>
                            <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<ExpenseCategory>()"></select>
                            <span asp-validation-for="Category" class="field-validation-error"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label required">@Loc["Amount"]</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">@Loc["CurrencySymbol"]</span>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="Amount" class="field-validation-error"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label">@Loc["Description"]</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="field-validation-error"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
                            <button type="submit" class="btn btn-teal px-4 fw-semibold">@Loc["Save"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
