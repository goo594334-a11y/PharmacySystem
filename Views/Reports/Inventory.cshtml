@model PharmacySystem.Models.ViewModels.Reports.InventoryReportViewModel
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["InventoryReport"];
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1">@Loc["InventoryReport"]</h4>
            <p class="text-muted small mb-0">@Loc["StockValuationAndBreakdown"]</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-dark d-print-none" onclick="window.print();">
                @Loc["PrintReport"]
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary d-print-none">@Loc["BackToReports"]</a>
        </div>
    </div>

    @* Inventory Valuation Cards *@
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm ph-card p-3 text-center">
                <div class="text-muted small">@Loc["EstimatedValuation"]</div>
                <div class="fs-4 fw-bold text-success mt-1">@Model.TotalInventoryValuation.ToString("C2")</div>
            </div>
        </div>
        <div class="col-6 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm ph-card p-3 text-center">
                <div class="text-muted small">@Loc["TotalStockUnits"]</div>
                <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalStockUnits</div>
            </div>
        </div>
        <div class="col-6 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm ph-card p-3 text-center">
                <div class="text-muted small">@Loc["ActiveBatches"]</div>
                <div class="fs-4 fw-bold text-teal mt-1">@Model.TotalBatchesCount</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm ph-card p-3 text-center">
                <div class="text-muted small">@Loc["LowStockProducts"]</div>
                <div class="fs-4 fw-bold text-warning mt-1">@Model.LowStockProductsCount</div>
            </div>
        </div>
    </div>

    @* Category Breakdown Table *@
    <div class="card border-0 shadow-sm ph-card overflow-hidden">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="card-title mb-0 fw-bold">@Loc["CategoryBreakdown"]</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 ph-table">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">@Loc["Category"]</th>
                        <th>@Loc["ProductsCount"]</th>
                        <th class="text-end pe-4">@Loc["TotalStockUnits"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.CategoryBreakdown)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">@c.CategoryName</td>
                            <td>@c.ProductsCount @Loc["Products"]</td>
                            <td class="text-end pe-4 fw-bold">@c.TotalUnits @Loc["Units"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
