@model List<PharmacySystem.Models.ViewModels.Notification.NotificationItemViewModel>
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    var unreadCount = Model.Count;
}

<div class="dropdown ph-notification-dropdown">
    <button class="ph-topbar-btn position-relative" type="button" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="@Loc["Notifications"]">
        <svg class="ph-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        @if (unreadCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger ph-pulse">
                @unreadCount
                <span class="visually-hidden">@Loc["UnreadCount"]</span>
            </span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end ph-notification-menu shadow-lg border-0" aria-labelledby="notificationDropdown">
        <div class="ph-notification-header d-flex justify-content-between align-items-center p-3 border-bottom">
            <h6 class="mb-0 fw-bold">@Loc["NotificationsTitle"]</h6>
            @if (unreadCount > 0)
            {
                <span class="badge bg-primary-subtle text-primary">@unreadCount @Loc["New"]</span>
            }
        </div>
        <div class="ph-notification-body" style="max-height: 320px; overflow-y: auto;">
            @if (Model.Count == 0)
            {
                <div class="text-center p-4 text-muted">
                    <svg class="ph-icon text-muted mb-2" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="m9 12 2 2 4-4"></path>
                    </svg>
                    <p class="small mb-0">@Loc["NoNewNotifications"]</p>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <a href="@(item.ActionUrl ?? "#")" class="dropdown-item d-flex gap-3 align-items-start p-3 border-bottom text-wrap ph-notification-item">
                        <div class="ph-notification-icon @item.BadgeClass text-white rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px;">
                            @if (item.Severity == PharmacySystem.Models.ViewModels.Notification.NotificationSeverity.Danger)
                            {
                                <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            }
                            else if (item.Severity == PharmacySystem.Models.ViewModels.Notification.NotificationSeverity.Warning)
                            {
                                <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                            }
                            else
                            {
                                <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold small text-dark">@item.Title</div>
                            <div class="small text-secondary">@item.Message</div>
                        </div>
                    </a>
                }
            }
        </div>
        @if (Model.Count > 0)
        {
            <div class="ph-notification-footer p-2 text-center border-top bg-light">
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">@Loc["ViewAllNotifications"]</a>
            </div>
        }
    </div>
</div>
