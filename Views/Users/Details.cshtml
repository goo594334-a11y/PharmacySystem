@model PharmacySystem.Models.ViewModels.Users.UserDetailsViewModel
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@using PharmacySystem.Enums
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["UserDetails"];
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">@Model.FullName</h4>
            <p class="text-muted small mb-0">@Model.Email</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary d-inline-flex align-items-center gap-1">
                <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                <span>@Loc["Edit"]</span>
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">@Loc["BackToList"]</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-5">
            <div class="card border-0 shadow-sm ph-card">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="card-title mb-0 fw-bold">@Loc["AccountInformation"]</h6>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">@Loc["FullName"]</dt>
                        <dd class="col-sm-7 fw-semibold">@Model.FullName</dd>

                        <dt class="col-sm-5 text-muted">@Loc["Email"]</dt>
                        <dd class="col-sm-7">@Model.Email</dd>

                        <dt class="col-sm-5 text-muted">@Loc["Role"]</dt>
                        <dd class="col-sm-7">
                            <span class="badge @(Model.Role == UserRole.Admin ? "bg-primary" : "bg-teal")">
                                @(Model.Role == UserRole.Admin ? Loc["Role_Admin"] : Loc["Role_Pharmacist"])
                            </span>
                        </dd>

                        <dt class="col-sm-5 text-muted">@Loc["Status"]</dt>
                        <dd class="col-sm-7">
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                                @(Model.IsActive ? Loc["Active"] : Loc["Inactive"])
                            </span>
                        </dd>

                        <dt class="col-sm-5 text-muted">@Loc["MustChangePassword"]</dt>
                        <dd class="col-sm-7">
                            <span class="badge @(Model.MustChangePassword ? "bg-warning text-dark" : "bg-light text-muted border")">
                                @(Model.MustChangePassword ? Loc["Yes"] : Loc["No"])
                            </span>
                        </dd>

                        <dt class="col-sm-5 text-muted">@Loc["CreatedAt"]</dt>
                        <dd class="col-sm-7 text-muted small">@Model.CreatedAt.ToLocalTime().ToString("g")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-7">
            <div class="card border-0 shadow-sm ph-card">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="card-title mb-0 fw-bold">@Loc["ActivitySummary"]</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3 text-center">
                        <div class="col-6 col-sm-4">
                            <div class="p-3 bg-light rounded">
                                <div class="fs-4 fw-bold text-teal">@Model.TotalSalesCount</div>
                                <div class="text-muted small">@Loc["TotalSales"]</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-4">
                            <div class="p-3 bg-light rounded">
                                <div class="fs-4 fw-bold text-primary">@Model.TotalPurchasesCount</div>
                                <div class="text-muted small">@Loc["Purchases"]</div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4">
                            <div class="p-3 bg-light rounded">
                                <div class="fs-4 fw-bold text-dark">@Model.TotalAuditLogsCount</div>
                                <div class="text-muted small">@Loc["AuditEvents"]</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
