@model PharmacySystem.Models.ViewModels.Dashboard.DashboardViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["Dashboard"];
}

@* Page Header & Quick Actions *@
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            @(Model.IsAdmin ? Loc["AdminDashboard"] : Loc["PharmacistDashboard"])
        </h3>
        <p class="text-muted small mb-0">@Loc["AppSubtitle"]</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <a asp-controller="Sales" asp-action="New" class="btn btn-teal shadow-sm d-flex align-items-center gap-2">
            <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span class="fw-semibold">@Loc["NewSale"]</span>
        </a>
        @if (Model.IsAdmin)
        {
            <a asp-controller="Purchases" asp-action="Create" class="btn btn-outline-primary d-flex align-items-center gap-1 shadow-sm">
                <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>@Loc["NewPurchase"]</span>
            </a>
            <a asp-controller="Products" asp-action="Create" class="btn btn-outline-secondary d-flex align-items-center gap-1">
                <span>+ @Loc["AddProduct"]</span>
            </a>
            <a asp-controller="Customers" asp-action="Create" class="btn btn-outline-secondary d-flex align-items-center gap-1">
                <span>+ @Loc["AddCustomer"]</span>
            </a>
            <a asp-controller="Suppliers" asp-action="Create" class="btn btn-outline-secondary d-flex align-items-center gap-1">
                <span>+ @Loc["AddSupplier"]</span>
            </a>
        }
    </div>
</div>

@* Financial & Operational KPI Cards Grid *@
<div class="row g-3 mb-4">
    @* Today's Sales *@
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="ph-stat-card ph-stat-teal h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="ph-stat-label">@Loc["TodaySales"]</div>
                <div class="badge bg-teal-subtle text-teal rounded-circle p-2">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                </div>
            </div>
            <div class="ph-stat-value">
                @Model.TodaySalesAmount.ToString("N2") <span class="fs-6 fw-normal text-muted">@Loc["CurrencySymbol"]</span>
            </div>
            <div class="small text-muted mt-2">
                <span class="fw-semibold text-dark">@Model.TodaySalesCount</span> @Loc["Sales"]
            </div>
        </div>
    </div>

    @if (Model.IsAdmin)
    {
        @* Today's Purchases *@
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="ph-stat-card ph-stat-sky h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="ph-stat-label">@Loc["TodayPurchases"]</div>
                    <div class="badge bg-info-subtle text-info rounded-circle p-2">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    </div>
                </div>
                <div class="ph-stat-value">
                    @Model.TodayPurchasesAmount.ToString("N2") <span class="fs-6 fw-normal text-muted">@Loc["CurrencySymbol"]</span>
                </div>
                <div class="small text-muted mt-2">
                    <span class="fw-semibold text-dark">@Model.TodayPurchasesCount</span> @Loc["Purchases"]
                </div>
            </div>
        </div>

        @* Today's Expenses *@
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="ph-stat-card h-100 border-start border-4 border-danger">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="ph-stat-label">@Loc["TodayExpenses"]</div>
                    <div class="badge bg-danger-subtle text-danger rounded-circle p-2">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </div>
                </div>
                <div class="ph-stat-value text-danger">
                    @Model.TodayExpensesAmount.ToString("N2") <span class="fs-6 fw-normal text-muted">@Loc["CurrencySymbol"]</span>
                </div>
                <div class="small text-muted mt-2">
                    <span class="fw-semibold text-dark">@Model.TodayExpensesCount</span> @Loc["Expenses"]
                </div>
            </div>
        </div>

        @* Today's Profit *@
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="ph-stat-card ph-stat-emerald h-100 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="ph-stat-label">@Loc["TodayProfit"]</div>
                    <div class="badge bg-success-subtle text-success rounded-circle p-2">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                    </div>
                </div>
                <div class="ph-stat-value text-success" dir="ltr">
                    @Model.TodayProfit.ToString("N2") <span class="fs-6 fw-normal text-muted">@Loc["CurrencySymbol"]</span>
                </div>
                <div class="small text-muted mt-2">
                    <span class="text-success fw-semibold">@Loc["NetGain"]</span>
                </div>
            </div>
        </div>
    }
    else
    {
        @* Pharmacist: Products on Hand *@
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="ph-stat-card ph-stat-sky h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="ph-stat-label">@Loc["TotalProducts"]</div>
                    <div class="badge bg-info-subtle text-info rounded-circle p-2">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path><path d="m8.5 8.5 7 7"></path></svg>
                    </div>
                </div>
                <div class="ph-stat-value">
                    @Model.TotalProductsCount
                </div>
                <div class="small text-muted mt-2">
                    <span class="fw-semibold text-dark">@Model.TotalInventoryQuantity</span> @Loc["UnitsInStock"]
                </div>
            </div>
        </div>
    }
</div>

@* Second Row: Inventory & Risk KPI Cards *@
<div class="row g-3 mb-4">
    @* Products Count / Inventory Value (Admin) *@
    @if (Model.IsAdmin)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="ph-stat-card ph-stat-sky h-100 shadow-sm border-0">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="ph-stat-label">@Loc["InventoryValue"]</div>
                    <div class="badge bg-primary-subtle text-primary rounded-circle p-2">
                        <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    </div>
                </div>
                <div class="ph-stat-value text-primary">
                    @Model.TotalInventoryValue.ToString("N2") <span class="fs-6 fw-normal text-muted">@Loc["CurrencySymbol"]</span>
                </div>
                <div class="small text-muted mt-2">
                    @Model.TotalInventoryQuantity @Loc["TotalUnits"] (@Model.TotalProductsCount @Loc["Products"])
                </div>
            </div>
        </div>
    }

    @* Low Stock Alerts *@
    <div class="col-12 col-sm-6 @(Model.IsAdmin ? "col-xl-3" : "col-xl-4")">
        <div class="ph-stat-card ph-stat-amber h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="ph-stat-label">@Loc["LowStockAlerts"]</div>
                <div class="badge bg-warning-subtle text-warning rounded-circle p-2">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                </div>
            </div>
            <div class="ph-stat-value text-warning">
                @Model.LowStockCount
            </div>
            <div class="small text-muted mt-2">
                <a asp-controller="Inventory" asp-action="Index" class="text-decoration-none small text-warning fw-semibold">@Loc["ViewLowStock"] &rarr;</a>
            </div>
        </div>
    </div>

    @* Near Expiry Alerts *@
    <div class="col-12 col-sm-6 @(Model.IsAdmin ? "col-xl-3" : "col-xl-4")">
        <div class="ph-stat-card ph-stat-rose h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="ph-stat-label">@Loc["NearExpiryAlerts"]</div>
                <div class="badge bg-danger-subtle text-danger rounded-circle p-2">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
            </div>
            <div class="ph-stat-value @(Model.NearExpiryCount > 0 ? "text-danger" : "text-dark")">
                @Model.NearExpiryCount
            </div>
            <div class="small text-muted mt-2">
                <a asp-controller="Inventory" asp-action="Index" class="text-decoration-none small text-danger fw-semibold">@Loc["Within90Days"] &rarr;</a>
            </div>
        </div>
    </div>

    @* Expired Batches *@
    <div class="col-12 col-sm-6 @(Model.IsAdmin ? "col-xl-3" : "col-xl-4")">
        <div class="ph-stat-card h-100 shadow-sm border-0 border-start border-4 border-dark">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="ph-stat-label">@Loc["ExpiredBatches"]</div>
                <div class="badge bg-dark-subtle text-dark rounded-circle p-2">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                </div>
            </div>
            <div class="ph-stat-value @(Model.ExpiredBatchesCount > 0 ? "text-danger fw-bold" : "text-dark")">
                @Model.ExpiredBatchesCount
            </div>
            <div class="small text-muted mt-2">
                <span class="text-muted">@Loc["BlockedFromSale"]</span>
            </div>
        </div>
    </div>
</div>

@* 7-Day Trend Overview (Admin only) - Interactive Chart.js *@
@if (Model.IsAdmin && Model.TrendDates.Count > 0)
{
    <div class="card border-0 shadow-sm ph-card mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h6 class="card-title mb-0 fw-bold">@Loc["WeeklyFinancialTrends"]</h6>
            <div class="d-flex gap-3 small">
                <span class="d-flex align-items-center gap-1"><span class="badge bg-teal rounded-circle p-1"> </span> @Loc["Sales"]</span>
                <span class="d-flex align-items-center gap-1"><span class="badge bg-primary rounded-circle p-1"> </span> @Loc["Purchases"]</span>
                <span class="d-flex align-items-center gap-1"><span class="badge bg-danger rounded-circle p-1"> </span> @Loc["Expenses"]</span>
            </div>
        </div>
        <div class="card-body p-4">
            <div style="position: relative; height: 280px;">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.IsAdmin && Model.TrendDates.Count > 0)
    {
        <script>
            (function() {
                const ctx = document.getElementById('trendChart');
                if (!ctx || typeof Chart === 'undefined') return;

                const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendDates));
                const salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend));
                const purchasesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PurchasesTrend));
                const expensesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpensesTrend));
                const isRtl = document.documentElement.dir === 'rtl';
                const currencySymbol = '@Loc["CurrencySymbol"]';

                const salesGradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 280);
                salesGradient.addColorStop(0, 'rgba(13, 115, 119, 0.25)');
                salesGradient.addColorStop(1, 'rgba(13, 115, 119, 0.02)');

                const purchasesGradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 280);
                purchasesGradient.addColorStop(0, 'rgba(59, 130, 246, 0.2)');
                purchasesGradient.addColorStop(1, 'rgba(59, 130, 246, 0.02)');

                const expensesGradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 280);
                expensesGradient.addColorStop(0, 'rgba(239, 68, 68, 0.15)');
                expensesGradient.addColorStop(1, 'rgba(239, 68, 68, 0.02)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: '@Loc["Sales"]',
                                data: salesData,
                                borderColor: '#0d7377',
                                backgroundColor: salesGradient,
                                fill: true,
                                tension: 0.4,
                                borderWidth: 2.5,
                                pointRadius: 4,
                                pointHoverRadius: 7,
                                pointBackgroundColor: '#0d7377',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointHoverBackgroundColor: '#ffffff',
                                pointHoverBorderColor: '#0d7377',
                                pointHoverBorderWidth: 3
                            },
                            {
                                label: '@Loc["Purchases"]',
                                data: purchasesData,
                                borderColor: '#3b82f6',
                                backgroundColor: purchasesGradient,
                                fill: true,
                                tension: 0.4,
                                borderWidth: 2,
                                pointRadius: 3,
                                pointHoverRadius: 6,
                                pointBackgroundColor: '#3b82f6',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointHoverBackgroundColor: '#ffffff',
                                pointHoverBorderColor: '#3b82f6',
                                pointHoverBorderWidth: 3
                            },
                            {
                                label: '@Loc["Expenses"]',
                                data: expensesData,
                                borderColor: '#ef4444',
                                backgroundColor: expensesGradient,
                                fill: true,
                                tension: 0.4,
                                borderWidth: 2,
                                borderDash: [5, 5],
                                pointRadius: 3,
                                pointHoverRadius: 6,
                                pointBackgroundColor: '#ef4444',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointHoverBackgroundColor: '#ffffff',
                                pointHoverBorderColor: '#ef4444',
                                pointHoverBorderWidth: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        rtl: isRtl,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: 'rgba(15, 23, 42, 0.9)',
                                titleFont: { size: 13, weight: '600', family: "'Inter', 'Cairo', sans-serif" },
                                bodyFont: { size: 12, family: "'Inter', 'Cairo', sans-serif" },
                                padding: 12,
                                cornerRadius: 10,
                                displayColors: true,
                                boxPadding: 4,
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ': ' + context.parsed.y.toFixed(2) + ' ' + currencySymbol;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: {
                                    font: { size: 11, family: "'Inter', 'Cairo', sans-serif" },
                                    color: '#94a3b8'
                                },
                                reverse: isRtl
                            },
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: 'rgba(226, 232, 240, 0.6)',
                                    drawBorder: false
                                },
                                ticks: {
                                    font: { size: 11, family: "'Inter', 'Cairo', sans-serif" },
                                    color: '#94a3b8',
                                    callback: function(value) {
                                        return value.toLocaleString();
                                    }
                                }
                            }
                        },
                        animation: {
                            duration: 1200,
                            easing: 'easeOutQuart'
                        }
                    }
                });
            })();
        </script>
    }
}

@* Main Operational Row: Recent Sales & Alerts *@
<div class="row g-4 mb-4">
    @* Recent Sales Invoices *@
    <div class="col-12 col-lg-7">
        <div class="card ph-card h-100">
            <div class="card-header ph-card-header d-flex justify-content-between align-items-center">
                <h5 class="fw-bold fs-6 mb-0 text-dark">@Loc["RecentSales"]</h5>
                <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-link text-decoration-none p-0">@Loc["View"] &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentSales.Count == 0)
                {
                    <partial name="_EmptyState" model='new PharmacySystem.Models.Common.EmptyStateViewModel(Loc["NoSalesFound"], null, "shopping-bag")' />
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table ph-table mb-0">
                            <thead>
                                <tr>
                                    <th>@Loc["InvoiceNumber"]</th>
                                    <th>@Loc["Customer"]</th>
                                    <th>@Loc["Date"]</th>
                                    <th>@Loc["TotalAmount"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sale in Model.RecentSales)
                                {
                                    <tr>
                                        <td class="fw-semibold text-teal">
                                            @sale.InvoiceNumber
                                        </td>
                                        <td>
                                            @(sale.Customer?.Name ?? Loc["WalkInCustomer"])
                                        </td>
                                        <td class="text-muted small">
                                            @sale.SaleDate.ToLocalTime().ToString("g")
                                        </td>
                                        <td class="fw-bold text-dark">
                                            @sale.TotalAmount.ToString("N2") @Loc["CurrencySymbol"]
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Inventory Risk & Alerts Feed *@
    <div class="col-12 col-lg-5">
        <div class="card ph-card h-100">
            <div class="card-header ph-card-header d-flex justify-content-between align-items-center">
                <h5 class="fw-bold fs-6 mb-0 text-dark">@Loc["InventoryAlertsSummary"]</h5>
                <a asp-controller="Inventory" asp-action="Index" class="btn btn-sm btn-link text-decoration-none p-0">@Loc["View"] &rarr;</a>
            </div>
            <div class="card-body p-3">
                @if (Model.LowStockProducts.Count == 0 && Model.NearExpiryBatches.Count == 0 && Model.ExpiredBatches.Count == 0)
                {
                    <div class="text-center py-4 text-muted">
                        <svg class="ph-icon text-success mb-2" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
                        <p class="small mb-0">@Loc["NoLowStockItems"]</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var low in Model.LowStockProducts)
                        {
                            <div class="p-2 border rounded-3 bg-warning-subtle d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold small text-dark">@low.ProductName</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @Loc["MinimumStockLevel"]: @low.MinimumStockLevel
                                    </div>
                                </div>
                                <span class="badge bg-warning text-dark">
                                    @low.AvailableQuantity @Loc["AvailableQuantity"]
                                </span>
                            </div>
                        }

                        @foreach (var expiry in Model.NearExpiryBatches)
                        {
                            <div class="p-2 border rounded-3 bg-danger-subtle d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold small text-dark">@expiry.ProductName</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @Loc["Batch"]: @expiry.BatchNumber | @Loc["Location"]: @expiry.LocationCode
                                    </div>
                                </div>
                                <span class="badge bg-danger">
                                    @expiry.RemainingDays @Loc["Days"]
                                </span>
                            </div>
                        }

                        @foreach (var expired in Model.ExpiredBatches)
                        {
                            <div class="p-2 border rounded-3 bg-dark-subtle d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold small text-dark">@expired.ProductName</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @Loc["Batch"]: @expired.BatchNumber (@Loc["Expired"])
                                    </div>
                                </div>
                                <span class="badge bg-dark">
                                    @expired.QuantityOnHand @Loc["Units"]
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Admin Recent Purchases & Audit Activity *@
@if (Model.IsAdmin)
{
    <div class="row g-4 mb-4">
        @* Recent Purchases *@
        <div class="col-12 col-lg-6">
            <div class="card ph-card h-100">
                <div class="card-header ph-card-header d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold fs-6 mb-0 text-dark">@Loc["RecentPurchases"]</h5>
                    <a asp-controller="Purchases" asp-action="Index" class="btn btn-sm btn-link text-decoration-none p-0">@Loc["View"] &rarr;</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentPurchases.Count == 0)
                    {
                        <div class="p-4 text-center text-muted small">@Loc["NoPurchasesFound"]</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table ph-table mb-0">
                                <thead>
                                    <tr>
                                        <th>@Loc["InvoiceNumber"]</th>
                                        <th>@Loc["Supplier"]</th>
                                        <th>@Loc["Date"]</th>
                                        <th>@Loc["TotalAmount"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var purchase in Model.RecentPurchases)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-primary">@purchase.InvoiceNumber</td>
                                            <td>@(purchase.Supplier?.Name ?? "-")</td>
                                            <td class="text-muted small">@purchase.PurchaseDate.ToLocalTime().ToString("g")</td>
                                            <td class="fw-bold text-dark">@purchase.TotalAmount.ToString("N2") @Loc["CurrencySymbol"]</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Recent Activity / Audit Log *@
        <div class="col-12 col-lg-6">
            <div class="card ph-card h-100">
                <div class="card-header ph-card-header d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold fs-6 mb-0 text-dark">@Loc["AuditLogs"]</h5>
                    <a asp-controller="AuditLogs" asp-action="Index" class="btn btn-sm btn-link text-decoration-none p-0">@Loc["View"] &rarr;</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentActivity.Count == 0)
                    {
                        <div class="p-4 text-center text-muted small">@Loc["NoRecentActivity"]</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table ph-table mb-0">
                                <thead>
                                    <tr>
                                        <th>@Loc["User"]</th>
                                        <th>@Loc["Actions"]</th>
                                        <th>@Loc["Category"]</th>
                                        <th>@Loc["Timestamp"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.RecentActivity)
                                    {
                                        <tr>
                                            <td class="fw-semibold">
                                                @(log.User?.FullName ?? Loc["System"])
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@log.Action</span>
                                            </td>
                                            <td class="text-muted small">
                                                @log.EntityName (#@log.EntityId)
                                            </td>
                                            <td class="text-muted small">
                                                @log.Timestamp.ToLocalTime().ToString("g")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
