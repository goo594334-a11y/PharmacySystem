@model PharmacySystem.Models.ViewModels.Users.EditUserViewModel
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@using PharmacySystem.Enums
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["EditUser"];
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm ph-card">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold">@Loc["EditUser"]</h5>
                    <p class="text-muted small mb-0">@Loc["EditUserSubtitle"]</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3" role="alert"></div>

                        @* Email (Readonly Identifier) *@
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">@Loc["Email"]</label>
                            <input asp-for="Email" class="form-control bg-light" readonly />
                        </div>

                        @* Full Name *@
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label required">@Loc["FullName"]</label>
                            <input asp-for="FullName" class="form-control" autofocus />
                            <span asp-validation-for="FullName" class="field-validation-error"></span>
                        </div>

                        @* Role *@
                        <div class="mb-3">
                            <label asp-for="Role" class="form-label required">@Loc["Role"]</label>
                            <select asp-for="Role" class="form-select">
                                <option value="@UserRole.Pharmacist">@Loc["Role_Pharmacist"]</option>
                                <option value="@UserRole.Admin">@Loc["Role_Admin"]</option>
                            </select>
                            <span asp-validation-for="Role" class="field-validation-error"></span>
                        </div>

                        @* Status *@
                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="userIsActiveSwitch" />
                            <label class="form-check-label" for="userIsActiveSwitch">@Loc["Active"]</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
                            <button type="submit" class="btn btn-teal px-4 fw-semibold">@Loc["Save"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
