@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["AccessDeniedTitle"];
}

<div class="row justify-content-center my-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card border-0 shadow-sm ph-card p-5">
            <div class="text-danger mb-4">
                <svg class="ph-icon" viewBox="0 0 24 24" width="72" height="72" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    <line x1="12" y1="15" x2="12" y2="17"></line>
                </svg>
            </div>
            <h3 class="fw-bold text-dark mb-2">@Loc["AccessDeniedTitle"]</h3>
            <p class="text-muted mb-4">@Loc["AccessDeniedDescription"]</p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-teal px-4 py-2 shadow-sm">
                    @Loc["ReturnToDashboard"]
                </a>
            </div>
        </div>
    </div>
</div>
