@model PharmacySystem.Models.ViewModels.Auth.ForgotPasswordViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    Layout = null;
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Loc["ForgotPassword"] - @Loc["AppTitle"]</title>

    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/pharmacy-theme.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-4">
    <div class="container" style="max-width: 440px;">
        <div class="d-flex justify-content-end mb-3">
            <partial name="_LanguageSwitcher" />
        </div>

        <div class="card border-0 shadow-lg ph-card overflow-hidden">
            <div class="card-header bg-teal text-white text-center p-4 border-0">
                <h4 class="fw-bold mb-1">@Loc["ForgotPassword"]</h4>
                <p class="text-white-50 small mb-0">@Loc["ForgotPasswordSubtitle"]</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label required">@Loc["Email"]</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="user@pharmacy.local" autocomplete="email" autofocus />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="btn btn-teal w-100 py-2 fw-semibold shadow-sm mb-3">
                        @Loc["SendOtpCode"]
                    </button>

                    <div class="text-center">
                        <a asp-action="Login" class="text-decoration-none small text-secondary">
                            &larr; @Loc["BackToLogin"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pharmacy.js" asp-append-version="true"></script>
</body>
</html>
