@model PharmacySystem.Models.ViewModels.Auth.RegisterAdminViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    Layout = null;
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Loc["FirstAdminRegistrationTitle"] - @Loc["AppTitle"]</title>

    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/pharmacy-theme.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-4">
    <div class="container" style="max-width: 500px;">
        @* Language Switcher *@
        <div class="d-flex justify-content-end mb-3">
            <partial name="_LanguageSwitcher" />
        </div>

        @* Flash Alerts *@
        <partial name="_AlertMessages" />

        @* Initial Admin Registration Card *@
        <div class="card border-0 shadow-lg ph-card overflow-hidden">
            <div class="card-header bg-teal text-white text-center p-4 border-0">
                <div class="ph-brand-icon bg-white text-teal rounded-circle mx-auto mb-3 p-3 d-inline-flex align-items-center justify-content-center shadow" style="width: 64px; height: 64px;">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <h4 class="fw-bold mb-1">@Loc["FirstAdminRegistrationTitle"]</h4>
                <p class="text-white-50 small mb-0">@Loc["FirstAdminRegistrationSubtitle"]</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="alert alert-info border-0 d-flex align-items-center gap-2 mb-4">
                    <svg class="ph-icon text-info flex-shrink-0" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                    <span class="small">@Loc["FirstAdminSetupNotice"]</span>
                </div>

                <form asp-controller="Account" asp-action="RegisterAdmin" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3" role="alert"></div>

                    @* Pharmacy Name *@
                    <div class="mb-3">
                        <label asp-for="PharmacyName" class="form-label required">@Loc["PharmacyName"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path><path d="m8.5 8.5 7 7"></path></svg>
                            </span>
                            <input asp-for="PharmacyName" class="form-control" placeholder="Al-Amal Pharmacy" autofocus />
                        </div>
                        <span asp-validation-for="PharmacyName" class="field-validation-error"></span>
                    </div>

                    @* Full Name *@
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label required">@Loc["FullName"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            </span>
                            <input asp-for="FullName" class="form-control" placeholder="Yousef Ali" />
                        </div>
                        <span asp-validation-for="FullName" class="field-validation-error"></span>
                    </div>

                    @* Real Email Address (Google / Gmail) *@
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label required">@Loc["Email"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                            </span>
                            <input asp-for="Email" type="email" class="form-control" placeholder="example@gmail.com" />
                        </div>
                        <div class="form-text small text-muted">@Loc["RealEmailRecommendedNotice"]</div>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    @* Phone Number *@
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">@Loc["Phone"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            </span>
                            <input asp-for="Phone" class="form-control" placeholder="010XXXXXXXX" />
                        </div>
                        <span asp-validation-for="Phone" class="field-validation-error"></span>
                    </div>

                    @* Address *@
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">@Loc["Address"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            </span>
                            <input asp-for="Address" class="form-control" placeholder="@Loc["PharmacyAddressPlaceholder"]" />
                        </div>
                        <span asp-validation-for="Address" class="field-validation-error"></span>
                    </div>

                    @* Password with Show/Hide Eye Toggle *@
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label required">@Loc["Password"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            </span>
                            <input asp-for="Password" type="password" class="form-control" id="registerAdminPasswordInput" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary toggle-password-btn" data-target="#registerAdminPasswordInput" aria-label="Toggle Password">
                                <svg class="ph-icon eye-open" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                <svg class="ph-icon eye-closed d-none" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="m1 1 22 22"></path><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    @* Confirm Password with Show/Hide Eye Toggle *@
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label required">@Loc["ConfirmPassword"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            </span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" id="registerAdminConfirmInput" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary toggle-password-btn" data-target="#registerAdminConfirmInput" aria-label="Toggle Password">
                                <svg class="ph-icon eye-open" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                <svg class="ph-icon eye-closed d-none" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="m1 1 22 22"></path><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path></svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="btn btn-teal w-100 py-2 fw-semibold shadow-sm mb-3">
                        @Loc["SubmitRegistrationRequest"]
                    </button>

                    <div class="text-center pt-2 border-top">
                        <span class="small text-muted">@Loc["AlreadyHaveAccount"] </span>
                        <a asp-action="Login" class="small text-teal fw-semibold text-decoration-none">
                            @Loc["Login"]
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="text-center text-muted small mt-4">
            &copy; @DateTime.UtcNow.Year @Loc["AppTitle"]
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/pharmacy.js" asp-append-version="true"></script>
</body>
</html>
