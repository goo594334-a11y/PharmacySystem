@using PharmacySystem.Extensions
@using PharmacySystem.Models.Common

@{
    var alerts = TempData.GetAlerts();
}

@if (alerts.Count > 0)
{
    <div class="ph-alerts-container mb-4">
        @foreach (var alert in alerts)
        {
            <div class="alert @alert.CssClass alert-dismissible fade show d-flex align-items-center shadow-sm ph-alert" role="alert">
                <div class="ph-alert-icon me-3">
                    @if (alert.Type == AlertType.Success)
                    {
                        <svg class="ph-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    }
                    else if (alert.Type == AlertType.Danger)
                    {
                        <svg class="ph-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                    }
                    else if (alert.Type == AlertType.Warning)
                    {
                        <svg class="ph-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    }
                    else
                    {
                        <svg class="ph-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                    }
                </div>
                <div class="flex-grow-1">
                    @if (!string.IsNullOrWhiteSpace(alert.Title))
                    {
                        <h6 class="alert-heading fw-bold mb-1">@alert.Title</h6>
                    }
                    <div>@alert.Message</div>
                </div>
                @if (alert.Dismissible)
                {
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                }
            </div>
        }
    </div>
}
