@using System.Globalization
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    Layout = null;
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Loc["RegistrationPendingTitle"] - @Loc["AppTitle"]</title>

    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/pharmacy-theme.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-4">
    <div class="container" style="max-width: 520px;">
        @* Language Switcher *@
        <div class="d-flex justify-content-end mb-3">
            <partial name="_LanguageSwitcher" />
        </div>

        <div class="card border-0 shadow-lg ph-card overflow-hidden text-center">
            <div class="card-header bg-teal text-white p-4 border-0">
                <div class="bg-white text-teal rounded-circle mx-auto mb-3 p-3 d-inline-flex align-items-center justify-content-center shadow" style="width: 72px; height: 72px;">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <h4 class="fw-bold mb-1">@Loc["RegistrationSubmittedTitle"]</h4>
                <p class="text-white-50 small mb-0">@Loc["RegistrationPendingApprovalSubtitle"]</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="alert alert-warning border-0 d-flex align-items-start gap-2 mb-4 text-start">
                    <svg class="ph-icon text-warning flex-shrink-0 mt-1" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    <div>
                        <div class="fw-semibold">@Loc["ReviewInProgress"]</div>
                        <div class="small">@Loc["RegistrationPendingExplanation"]</div>
                    </div>
                </div>

                <p class="text-muted small mb-4">
                    @Loc["RegistrationPendingNextSteps"]
                </p>

                <div class="d-grid gap-2">
                    <a asp-action="Login" class="btn btn-teal py-2 fw-semibold shadow-sm">
                        @Loc["BackToLogin"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
