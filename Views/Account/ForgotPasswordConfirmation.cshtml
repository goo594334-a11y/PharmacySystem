@using System.Globalization
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Hosting
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc
@inject IWebHostEnvironment Env

@{
    Layout = null;
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var resetLink = Env.IsDevelopment() ? (TempData["ResetLinkPreview"] as string) : null;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Loc["ForgotPasswordConfirmationTitle"] - @Loc["AppTitle"]</title>

    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/pharmacy-theme.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-4">
    <div class="container" style="max-width: 480px;">
        <div class="card border-0 shadow-lg ph-card overflow-hidden">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="text-success mb-3">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                </div>
                <h4 class="fw-bold mb-2">@Loc["ForgotPasswordConfirmationTitle"]</h4>
                <p class="text-muted small mb-4">
                    @Loc["ForgotPasswordConfirmationMessage"]
                </p>

                @if (!string.IsNullOrEmpty(resetLink))
                {
                    <div class="alert alert-info small text-start mb-4">
                        <strong>@Loc["DevelopmentResetLinkNotice"]:</strong><br />
                        <a href="@resetLink" class="text-break">@resetLink</a>
                    </div>
                }

                <a asp-action="Login" class="btn btn-teal px-4 fw-semibold shadow-sm">
                    @Loc["BackToLogin"]
                </a>
            </div>
        </div>
    </div>
</body>
</html>
