@model PharmacySystem.Models.ViewModels.Auth.ResetPasswordViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@inject IStringLocalizer<SharedResource> Loc

@{
    Layout = null;
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Loc["ResetPassword"] - @Loc["AppTitle"]</title>

    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/pharmacy-theme.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-4">
    <div class="container" style="max-width: 440px;">
        <div class="d-flex justify-content-end mb-3">
            <partial name="_LanguageSwitcher" />
        </div>

        <div class="card border-0 shadow-lg ph-card overflow-hidden">
            <div class="card-header bg-teal text-white text-center p-4 border-0">
                <h4 class="fw-bold mb-1">@Loc["ResetPassword"]</h4>
                <p class="text-white-50 small mb-0">@Loc["ResetPasswordSubtitle"]</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3" role="alert"></div>

                    @* New Password *@
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label required">@Loc["NewPassword"]</label>
                        <div class="input-group">
                            <input asp-for="NewPassword" type="password" class="form-control border-end-0" id="resetNewPasswordInput" />
                            <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password-btn" data-target="#resetNewPasswordInput" aria-label="Toggle Password">
                                <svg class="ph-icon eye-open" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                <svg class="ph-icon eye-closed d-none" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="m1 1 22 22"></path><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path></svg>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                    </div>

                    @* Confirm Password *@
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label required">@Loc["ConfirmPassword"]</label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" type="password" class="form-control border-end-0" id="resetConfirmPasswordInput" />
                            <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password-btn" data-target="#resetConfirmPasswordInput" aria-label="Toggle Password">
                                <svg class="ph-icon eye-open" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                <svg class="ph-icon eye-closed d-none" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="m1 1 22 22"></path><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path></svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="btn btn-teal w-100 py-2 fw-semibold shadow-sm mb-3">
                        @Loc["ResetPassword"]
                    </button>
                </form>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pharmacy.js" asp-append-version="true"></script>
</body>
</html>
