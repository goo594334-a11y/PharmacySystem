@model PharmacySystem.Models.Common.PaginatedList<PharmacySystem.Models.ViewModels.Users.UserListItemViewModel>
@using Microsoft.Extensions.Localization
@using PharmacySystem.Resources
@using PharmacySystem.Enums
@inject IStringLocalizer<SharedResource> Loc

@{
    ViewData["Title"] = Loc["Nav_Users"];
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1">@Loc["Nav_Users"]</h4>
            <p class="text-muted small mb-0">@Loc["UserManagementSubtitle"]</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-teal d-inline-flex align-items-center gap-2 shadow-sm">
                <svg class="ph-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>@Loc["AddUser"]</span>
            </a>
        </div>
    </div>

    @* One-Time Temporary Password Alert (Shown immediately after Admin creates/resets user) *@
    @if (TempData["TempPassword"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-warning text-dark p-2 rounded-circle d-flex align-items-center justify-content-center">
                    <svg class="ph-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <div>
                    <h6 class="alert-heading fw-bold mb-1">@Loc["TemporaryPasswordNotice"]</h6>
                    <p class="mb-1">
                        @Loc["TemporaryPasswordFor"]: <strong>@TempData["CreatedUserEmail"]</strong> &rarr;
                        <code class="fs-5 px-2 py-1 bg-light rounded text-dark border">@TempData["TempPassword"]</code>
                    </p>
                    <small class="text-muted">@Loc["TemporaryPasswordWarning"]</small>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Search & Filter Card *@
    <div class="card border-0 shadow-sm ph-card mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <svg class="ph-icon text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        </span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="@Loc["SearchPlaceholderUsers"]" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="role" class="form-select">
                        <option value="">-- @Loc["AllRoles"] --</option>
                        <option value="@UserRole.Admin" selected="@(ViewBag.Role == UserRole.Admin ? "selected" : null)">@Loc["Role_Admin"]</option>
                        <option value="@UserRole.Pharmacist" selected="@(ViewBag.Role == UserRole.Pharmacist ? "selected" : null)">@Loc["Role_Pharmacist"]</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select name="isActive" class="form-select">
                        <option value="">-- @Loc["AllStatuses"] --</option>
                        <option value="true" selected="@(ViewBag.IsActive == true ? "selected" : null)">@Loc["Active"]</option>
                        <option value="false" selected="@(ViewBag.IsActive == false ? "selected" : null)">@Loc["Inactive"]</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-teal w-100">@Loc["Filter"]</button>
                    @if (!string.IsNullOrEmpty(ViewBag.Search) || ViewBag.Role != null || ViewBag.IsActive != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">@Loc["Clear"]</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @* Users Table Card *@
    <div class="card border-0 shadow-sm ph-card overflow-hidden">
        @if (!Model.Items.Any())
        {
            <div class="p-5 text-center">
                <partial name="_EmptyState" model='new PharmacySystem.Models.Common.EmptyStateViewModel { Title = Loc["NoUsersFound"], Message = Loc["NoUsersFoundMessage"], ActionText = Loc["AddUser"], ActionUrl = Url.Action("Create") }' />
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 ph-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Loc["FullName"]</th>
                            <th>@Loc["Email"]</th>
                            <th>@Loc["Role"]</th>
                            <th>@Loc["Status"]</th>
                            <th>@Loc["Transactions"]</th>
                            <th class="text-end pe-4">@Loc["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="ph-avatar-sm bg-light text-teal rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px;">
                                            @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "U")
                                        </div>
                                        <span class="fw-semibold text-dark">@user.FullName</span>
                                    </div>
                                </td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    <span class="badge @(user.Role == UserRole.Admin ? "bg-primary" : "bg-teal")">
                                        @(user.Role == UserRole.Admin ? Loc["Role_Admin"] : Loc["Role_Pharmacist"])
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                                        @(user.IsActive ? Loc["Active"] : Loc["Inactive"])
                                    </span>
                                </td>
                                <td class="small text-muted">
                                    <span>@Loc["Sales"]: @user.SalesCount</span> | <span>@Loc["Purchases"]: @user.PurchasesCount</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="@Loc["Details"]">
                                            <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="@Loc["Edit"]">
                                            <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </a>
                                        <form asp-action="ResetPassword" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('@Loc["ConfirmResetUserPassword"]');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="@Loc["ResetPassword"]">
                                                <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                            </button>
                                        </form>
                                        <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(user.IsActive ? "btn-outline-secondary" : "btn-outline-success")" title="@(user.IsActive ? Loc["Deactivate"] : Loc["Activate"])">
                                                <svg class="ph-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination *@
            <div class="card-footer bg-white border-top p-3">
                <partial name="_Pagination" model="Model.ToPaginationViewModel()" />
            </div>
        }
    </div>
</div>
